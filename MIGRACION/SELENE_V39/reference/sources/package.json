{
  "name": "spacegame",
  "version": "0.1.0",
  "private": true,
  "description": "FPV co-op lunar exploration prototype",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "play": "vite build && tsx src/server/index.ts",
    "share": "cloudflared tunnel --url http://localhost:3000",
    "typecheck": "tsc --noEmit -p .",
    "diag:terrain": "node tools/diag/shots.mjs terrain \"0,0,1.57,-0.25,1.8;0,0,2.5,-0.1,1.8;10,10,0.8,-0.75,25\"",
    "diag:joints": "node tools/diag/joints.mjs",
    "diag:grasp": "node tools/diag/grasp.mjs",
    "diag:pose": "node tools/diag/shots.mjs pose \"2.9,2;1.6,2;0.4,2;1.3,2.2,1\"",
    "test:ship": "tsx tools/ship/check.ts",
    "test:equipment": "tsx tools/ship/equipment.ts",
    "test:cameras": "tsx tools/ship/cameras.ts",
    "test:terrain": "tsx tools/ship/terrainSeams.ts",
    "test:space": "tsx tools/ship/space.ts",
    "test:motion": "tsx tools/motion/check.ts",
    "test:motion:net": "tsx tools/motion/net.ts",
    "test:net": "tsx tools/net/check.ts",
    "test:actors": "tsx tools/actors/check.ts",
    "test:world": "tsx tools/net/world.ts",
    "test:npcs": "tsx tools/net/npcs.ts",
    "test:galaxy": "tsx tools/space/galaxy.ts",
    "test:render": "tsx tools/perf/render.ts",
    "test:sim": "tsx tools/sim/check.ts && tsx tools/sim/kit.ts && tsx tools/sim/tools.ts",
    "test:sim:server": "tsx tools/sim/server.ts",
    "bench:sim": "tsx tools/sim/bench.ts",
    "sim:why": "tsx tools/sim/why.ts",
    "sim:seeds": "tsx tools/sim/seeds.ts",
    "sim:scope": "tsx tools/sim/scope.ts",
    "diag:equipment": "node tools/diag/equipment.mjs",
    "perf": "tsx tools/perf/perf.ts",
    "diag:ship": "node tools/diag/ship.mjs",
    "diag:manual": "node tools/diag/manual.mjs",
    "diag:space": "node tools/diag/flight_space.mjs",
    "diag:ship:net": "node tools/diag/ship_net.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "cloudflared": "^0.7.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
