// Machines and modules: they plug into networks (see core/src/structure/networks.rs). module.params:
// produce / consume (per second: kW for "energia", kg/s for "propelente"), store (kJ, kg),
// priority (higher is served first when there is not enough); module.kind may name a machine that
// changes them with the circumstances ("solar": as much as the sun falls on its face).
{
  "modulo":      { "name": "Módulo habitable", "shape": { "kind": "cylinder", "radius": 2.0, "height": 6.0, "sides": 16 }, "material": "aluminio", "hollow": 0.012, "ports": ["energia", "aire", "datos"], "module": { "kind": "habitat", "params": { "consume": { "energia": 4.0 }, "priority": 2 } } },
  "tunel":       { "name": "Túnel", "shape": { "kind": "cylinder", "radius": 0.8, "height": 2.0, "sides": 16 }, "material": "aluminio", "hollow": 0.01, "ports": ["energia", "aire", "datos"] },
  "tanque":      { "name": "Tanque", "shape": { "kind": "cylinder", "radius": 1.0, "height": 2.4, "sides": 12 }, "material": "acero", "hollow": 0.008, "ports": ["propelente"], "module": { "kind": "deposito", "params": { "store": { "propelente": 4000.0 } } } },
  "reactor":     { "name": "Reactor", "shape": { "kind": "cylinder", "radius": 1.2, "height": 2.0, "sides": 12 }, "material": "acero", "hollow": 0.05, "color": [90, 92, 96], "ports": ["energia"], "module": { "kind": "reactor", "params": { "produce": { "energia": 120.0 } } } },
  "panel_solar": { "name": "Panel solar", "shape": { "kind": "box", "size": [4.0, 0.06, 2.0] }, "material": "silicio", "ports": ["energia"], "module": { "kind": "solar", "params": { "produce": { "energia": 6.0 } } } },
  "antena":      { "name": "Antena", "shape": { "kind": "cylinder", "radius": 0.8, "height": 0.25, "sides": 12, "taper": 0.15 }, "material": "aluminio", "ports": ["datos", "energia"], "module": { "kind": "antena", "params": { "consume": { "energia": 0.5 } } } },
  "luz":         { "name": "Foco", "shape": { "kind": "box", "size": [0.3, 0.15, 0.3] }, "material": "compuesto", "glow": 220, "ports": ["energia"], "module": { "kind": "luz", "params": { "consume": { "energia": 0.3 }, "priority": 0 } } },
  "motor":       { "name": "Motor", "shape": { "kind": "cylinder", "radius": 0.9, "height": 1.6, "sides": 12, "taper": 0.6 }, "material": "acero", "hollow": 0.03, "color": [70, 70, 74], "ports": ["propelente", "energia"], "module": { "kind": "motor", "params": {} } },
  "bateria":     { "name": "Batería", "shape": { "kind": "box", "size": [0.8, 0.6, 0.5] }, "material": "compuesto", "color": [60, 66, 80], "ports": ["energia"], "module": { "kind": "bateria", "params": { "store": { "energia": 200000.0 } } } }
}
