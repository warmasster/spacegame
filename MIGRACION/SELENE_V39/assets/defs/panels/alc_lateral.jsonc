// Pilot side console of the Alcotán: the flight stick, yaw and translation (sprung to centre).
// Seated, the keys move them (see the seat's bindings in the ship).
{
  "name": "Mandos de vuelo",
  "tamano": ["0.26 m", "0.60 m"],
  "rejilla": [2, 6],
  "margen": "8 mm",
  "separacion": "4 mm",
  "grupos": [
    { "id": "mando", "titulo": "MANDO", "celda": [0, 0], "ocupa": [2, 3] },
    { "id": "tras", "titulo": "TRASLACIÓN", "celda": [0, 3], "ocupa": [2, 3] }
  ],
  "mandos": [
    { "id": "palanca", "kind": "palanca", "grupo": "mando", "ejes": 2, "rango": [-1.0, 1.0], "muelle_al_centro": true,
      "bind": { "senal": "vuelo.cabeceo", "senal_y": "vuelo.alabeo" }, "nombre": "Palanca de mando",
      "ayuda": "Adelante y atrás: cabeceo. A los lados: alabeo. Con el ordenador, pide velocidad de giro; sin él, empuje directo. Sentado: W/S, Q/E." },
    { "id": "guinada", "kind": "palanca", "grupo": "mando", "rango": [-1.0, 1.0], "muelle_al_centro": true, "recorrido": 40, "tamano": [28, 60],
      "bind": { "senal": "vuelo.guinada" }, "rotulo": "GUIÑADA", "nombre": "Guiñada", "ayuda": "Sentado: A/D." },
    { "id": "traslacion", "kind": "palanca", "grupo": "tras", "ejes": 2, "rango": [-1.0, 1.0], "muelle_al_centro": true,
      "bind": { "senal": "vuelo.tz", "senal_y": "vuelo.tx" }, "nombre": "Traslación", "ayuda": "Adelante/atrás y a los lados con el RCS. Sentado: I/K, J/L." },
    { "id": "vertical", "kind": "palanca", "grupo": "tras", "rango": [-1.0, 1.0], "muelle_al_centro": true, "recorrido": 40, "tamano": [28, 60],
      "bind": { "senal": "vuelo.ty" }, "rotulo": "SUBIR", "nombre": "Subir y bajar", "ayuda": "Sentado: R/F." }
  ]
}
