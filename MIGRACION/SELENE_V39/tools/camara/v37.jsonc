// V37: the hands as hands are. Sat at the Alcotán's and the Abejorro's controls with the stick
// and the throttle in them (the hands' own axes drawn: "ejes_manos", and each wrist's angles to
// the log: "manos"), a control worked, the wrist computer up, a clap, and the launcher on its
// shoulder looking up and down and going up a ramp, seen from outside.
// Run: luna --guion tools/camara/v37.jsonc → out/camara/v37_*.png
{
  "registro": "out/camara/v37.log",
  "naves": ["alcotan", "abejorro"],
  "pasos": [
    { "nave": "alcotan" },
    { "esperar": 2.0 },
    { "linterna": true },
    { "ejes_manos": true },
    // ---- sat in the Alcotán: the left hand on the throttle, the right on the stick
    { "sentar": "piloto" },
    { "esperar": 1.5 },
    { "nota": "alcotán, sentado, manos en palanca y gases:" },
    { "manos": null },
    { "camara": { "en": [1.35, 1.2, 5.5], "mira": [0.96, 0.78, 5.0], "fov": 50 } },
    { "foto": "out/camara/v37_alc_gases.png" },
    { "camara": { "en": [-0.15, 1.25, 5.55], "mira": [0.28, 0.84, 5.05], "fov": 50 } },
    { "foto": "out/camara/v37_alc_palanca.png" },
    { "ejes_manos": false },
    { "camara": { "en": [0.62, 1.85, 3.75], "mira": [0.62, 0.95, 5.2], "fov": 62 } },
    { "foto": "out/camara/v37_alc_detras.png" },
    // a switch overhead and a lever of the main panel worked: the hand on its way and on it
    { "pulsar": "techo/rad" },
    { "esperar": 0.1 },
    { "foto": "out/camara/v37_alc_techo_0.png" },
    { "esperar": 0.25 },
    { "nota": "alcotán, techo/rad accionado:" },
    { "manos": null },
    { "foto": "out/camara/v37_alc_techo_1.png" },
    { "esperar": 1.6 },
    { "pulsar": "principal/tren" },
    { "esperar": 0.3 },
    { "nota": "alcotán, principal/tren accionado:" },
    { "manos": null },
    { "foto": "out/camara/v37_alc_tren.png" },
    { "esperar": 1.6 },
    { "pulsar": "pedestal/mantener" },
    { "esperar": 0.3 },
    { "nota": "alcotán, pedestal/mantener accionado:" },
    { "manos": null },
    { "ejes_manos": true },
    { "foto": "out/camara/v37_alc_pedestal.png" },
    { "esperar": 1.6 },
    { "sentar": "" },
    // ---- sat in the Abejorro
    { "nave": "abejorro" },
    { "sentar": "piloto" },
    { "esperar": 1.5 },
    { "nota": "abejorro, sentado:" },
    { "manos": null },
    { "ejes_manos": false },
    { "camara": { "en": [-1.5, 1.25, 1.75], "mira": [-0.2, 0.75, 1.05], "fov": 45 } },
    { "foto": "out/camara/v37_abe_palanca.png" },
    { "camara": { "en": [1.5, 1.25, 1.75], "mira": [0.2, 0.75, 1.05], "fov": 45 } },
    { "foto": "out/camara/v37_abe_gases.png" },
    { "sentar": "" },
    // ---- on foot by it: the wrist computer up, from outside and from its own eyes
    { "ir": [3.6, -1.65, 4.2] },
    { "mirar_a": [0, 0.6, 0.8] },
    { "esperar": 1.0 },
    { "muneca": true },
    { "esperar": 1.8 },
    { "nota": "ordenador de muñeca arriba:" },
    { "manos": null },
    { "camara_jugador": { "en": [0.75, 1.75, 0.95], "mira": [0.05, 1.42, 0.3], "fov": 40 } },
    { "foto": "out/camara/v37_muneca_fuera.png" },
    { "camara_jugador": { "en": [0.05, 1.95, -0.25], "mira": [0.06, 1.5, 0.35], "fov": 50 } },
    { "foto": "out/camara/v37_muneca_hombro.png" },
    { "jugador": null },
    { "esperar": 0.4 },
    { "foto": "out/camara/v37_muneca_ojos.png" },
    { "muneca": false },
    { "esperar": 1.0 },
    // ---- a clap, as the palms meet
    { "camara_jugador": { "en": [0.35, 1.5, 1.7], "mira": [0, 1.3, 0.3], "fov": 40 } },
    { "gesto": "aplaudir" },
    { "esperar": 0.76 },
    { "foto": "out/camara/v37_palmada.png" },
    { "esperar": 1.6 },
    // ---- the launcher on its shoulder: level, looking up, looking down
    { "equipo": "lanzacohetes" },
    { "esperar": 1.4 },
    { "nota": "lanzacohetes al hombro, vista a nivel:" },
    { "manos": null },
    { "camara_jugador": { "en": [-1.6, 1.6, 0.9], "mira": [-0.1, 1.4, 0.25], "fov": 45 } },
    { "foto": "out/camara/v37_lanzador_nivel.png" },
    { "mirar": [-140, 50] },
    { "esperar": 0.8 },
    { "nota": "lanzacohetes, mirando 50° arriba:" },
    { "manos": null },
    { "foto": "out/camara/v37_lanzador_arriba.png" },
    { "mirar": [-140, -40] },
    { "esperar": 0.8 },
    { "nota": "lanzacohetes, mirando 40° abajo:" },
    { "manos": null },
    { "foto": "out/camara/v37_lanzador_abajo.png" },
    { "jugador": null },
    { "mirar": [-140, 35] },
    { "esperar": 0.6 },
    { "foto": "out/camara/v37_lanzador_ojos_arriba.png" },
    // ---- up the Alcotán's ramp with it, seen from outside (V)
    { "nave": "alcotan" },
    { "ir": [0.3, -1.4, -15.2] },
    { "mirar_a": [0.3, 1.2, -2.0] },
    { "tercera": 3.2 },
    { "esperar": 1.0 },
    { "andar": [1, 0] },
    { "esperar": 1.5 },
    { "nota": "rampa arriba, 1,5 s:" },
    { "manos": null },
    { "foto": "out/camara/v37_rampa_1.png" },
    { "esperar": 0.7 },
    { "nota": "rampa arriba, 2,2 s:" },
    { "manos": null },
    { "foto": "out/camara/v37_rampa_2.png" },
    { "andar": [-1, 0] },
    { "esperar": 1.2 },
    { "nota": "rampa abajo (de espaldas), 1,2 s:" },
    { "manos": null },
    { "foto": "out/camara/v37_rampa_3.png" },
    { "andar": [0, 0] },
    { "tercera": 0 },
    { "esperar": 0.4 },
    { "foto": "out/camara/v37_rampa_ojos.png" },
    { "equipo": "" },
    { "esperar": 0.4 }
  ]
}
