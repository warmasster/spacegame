// Exhaust (docs/CHORROS.md): the suit's pack seen from outside (lifting, holding its height,
// sideways, braking, ahead, pushing down) and from one's own eyes, the Abejorro on its four lift engines and its cold
// gas, and the Alcotán: its engines lighting, at idle on the ground and holding it in the air,
// its reaction control jets turning and sliding it, and its engines stopping.
// The engines are started as a pilot would, through the ships' own controls; the ships are then
// flown with MANTENER (the flight computer holds them over the ground) and their levers held as
// a seat's keys hold them ("eje").
// Run: luna --guion tools/camara/chorros.jsonc → out/camara/chorros_*.png, chorros.log
{
  "registro": "out/camara/chorros.log",
  "naves": ["abejorro", "alcotan"],
  "pasos": [
    // ---- the pack: by the tug, seen from outside ----
    { "nave": "abejorro" },
    { "esperar": 1.5 },
    { "ir": [6.0, -1.65, 5.0] },
    { "mirar_a": [0, 0.6, 0.8] },
    { "mochila": true },
    { "camara_jugador": { "en": [-2.2, 1.4, -2.2], "mira": [0, 1.0, 0], "fov": 55 } },
    { "subir": true },
    { "esperar": 0.7 },
    { "foto": "out/camara/chorros_mochila_subir.png" },
    { "esperar": 0.5 },
    { "subir": false },
    { "esperar": 1.2 },
    { "camara_jugador": { "en": [0.3, 0.9, -2.6], "mira": [0, 1.2, 0], "fov": 50 } },
    { "foto": "out/camara/chorros_mochila_sostener.png" },
    { "andar": [0, 1] },
    { "esperar": 0.5 },
    { "foto": "out/camara/chorros_mochila_lado.png" },
    { "andar": [0, 0] },
    { "esperar": 0.12 },
    { "foto": "out/camara/chorros_mochila_frenar.png" },
    { "esperar": 1.0 },
    { "andar": [1, 0] },
    { "camara_jugador": { "en": [-2.6, 1.3, -0.4], "mira": [0, 1.2, 0], "fov": 50 } },
    { "esperar": 0.5 },
    { "foto": "out/camara/chorros_mochila_adelante.png" },
    { "andar": [0, 0] },
    { "esperar": 1.0 },
    { "bajar": true },
    { "esperar": 0.25 },
    { "foto": "out/camara/chorros_mochila_bajar.png" },
    { "bajar": false },
    // from one's own eyes: looking down while it lifts, and its forward jets (over the
    // shoulders) while it pushes back
    "jugador",
    { "mirar": [0, -62] },
    { "subir": true },
    { "esperar": 0.5 },
    { "foto": "out/camara/chorros_mochila_ojos_abajo.png" },
    { "subir": false },
    { "mirar": [0, -5] },
    { "andar": [-1, 0] },
    { "esperar": 0.5 },
    { "foto": "out/camara/chorros_mochila_ojos_atras.png" },
    { "andar": [0, 0] },
    { "mochila": false },
    { "esperar": 2.0 },

    // ---- the Abejorro: four lift engines and cold gas ----
    { "pulsar": "consola/tapa_arm" },
    { "esperar": 0.3 },
    { "pulsar": "consola/arm" },
    { "esperar": 0.3 },
    { "pulsar": "consola/arr" },
    { "esperar": 0.4 },
    { "camara": { "en": [5.0, -0.5, 5.6], "mira": [1.0, -0.8, 1.2], "fov": 55 } },
    { "pulsar": "consola/arr" },
    { "esperar": 0.85 },
    { "foto": "out/camara/chorros_abejorro_arranque.png" },
    { "esperar": 2.5 },
    { "foto": "out/camara/chorros_abejorro_ralenti.png" },
    { "pulsar": "consola/mantener" },
    { "eje": { "mando": "consola/vertical", "valor": 1.0 } },
    { "esperar": 0.8 },
    { "foto": "out/camara/chorros_abejorro_despegue.png" },
    { "esperar": 1.7 },
    { "eje": { "mando": "consola/vertical", "valor": 0.0 } },
    { "esperar": 2.0 },
    { "volcar": ["motor_proa_izq.empuje", "motor_proa_izq.estado", "vuelo.tierra", "vuelo.modo"] },
    { "camara": { "en": [7.5, 0.2, 6.5], "mira": [0, -1.2, 0], "fov": 55 } },
    { "foto": "out/camara/chorros_abejorro_vuelo.png" },
    { "camara": { "en": [3.6, -0.5, 4.2], "mira": [1.72, -0.9, 2.3], "fov": 50 } },
    { "foto": "out/camara/chorros_abejorro_motor.png" },
    { "camara": { "en": [4.6, 0.7, 4.4], "mira": [1.8, 0.0, 2.3], "fov": 50 } },
    { "eje": { "mando": "consola/traslacion", "eje": 1, "valor": -1.0 } },
    { "esperar": 0.35 },
    { "foto": "out/camara/chorros_abejorro_gas_frio.png" },
    { "volcar": ["rcs_proa_izq_fuera.empuje", "rcs_proa_der_fuera.empuje", "rcs_popa_izq_fuera.empuje", "rcs_popa_der_fuera.empuje"] },
    { "eje": { "mando": "consola/traslacion", "eje": 1, "valor": 0.0 } },
    { "esperar": 0.5 },

    // ---- the Alcotán: its two engines ----
    { "nave": "alcotan" },
    { "pulsar": "pedestal/tapa_arm_izq" },
    { "pulsar": "pedestal/arm_izq" },
    { "pulsar": "pedestal/tapa_arm_der" },
    { "pulsar": "pedestal/arm_der" },
    { "pulsar": "pedestal/arr_izq" },
    { "pulsar": "pedestal/arr_der" },
    { "esperar": 0.5 },
    { "camara": { "en": [10.5, 0.2, -9.0], "mira": [5.05, -0.6, -4.0], "fov": 50 } },
    { "pulsar": "pedestal/arr_izq" },
    { "pulsar": "pedestal/arr_der" },
    // (purge 0.5 s, ignition 0.4 s: the first gas)
    { "esperar": 1.05 },
    { "foto": "out/camara/chorros_alcotan_arranque.png" },
    { "esperar": 3.0 },
    { "volcar": ["gondola_izq.empuje", "gondola_izq.estado", "gondola_der.empuje", "vuelo.tierra", "vuelo.modo"] },
    { "foto": "out/camara/chorros_alcotan_ralenti.png" },
    // up on MANTENER, climbing for three seconds and a half, then holding there
    { "pulsar": "pedestal/mantener" },
    { "eje": { "mando": "lateral/vertical", "valor": 1.0 } },
    { "esperar": 3.5 },
    { "eje": { "mando": "lateral/vertical", "valor": 0.0 } },
    { "esperar": 2.5 },
    { "volcar": ["gondola_izq.empuje", "gondola_der.empuje", "vuelo.tierra", "vuelo.modo"] },
    { "camara": { "en": [15.0, -1.5, -7.0], "mira": [3.0, -1.5, -4.0], "fov": 50 } },
    { "foto": "out/camara/chorros_alcotan_vuelo.png" },
    { "camara": { "en": [8.5, -4.0, -11.0], "mira": [5.05, -2.5, -4.0], "fov": 55 } },
    { "foto": "out/camara/chorros_alcotan_tobera.png" },
    { "camara": { "en": [5.05, -9.0, -4.6], "mira": [5.05, 0.0, -4.0], "fov": 60 } },
    { "foto": "out/camara/chorros_alcotan_desde_abajo.png" },
    { "camara": { "en": [2.0, 9.0, -30.0], "mira": [0, -2.0, -4.0], "fov": 45 } },
    { "foto": "out/camara/chorros_alcotan_popa.png" },
    { "camara": { "en": [60.0, 6.0, 40.0], "mira": [0, 0.0, -2.0], "fov": 35 } },
    { "foto": "out/camara/chorros_alcotan_lejos.png" },
    // its reaction control jets: the stick held (nose up), then sliding sideways
    { "camara": { "en": [4.2, 2.6, 8.6], "mira": [1.4, 1.45, 6.2], "fov": 45 } },
    { "eje": { "mando": "lateral/palanca", "valor": -1.0 } },
    { "esperar": 0.2 },
    { "foto": "out/camara/chorros_rcs_cabeceo.png" },
    { "volcar": ["rcs_proa_izq_arriba.empuje", "rcs_proa_izq_abajo.empuje", "rcs_popa_izq_arriba.empuje", "rcs_popa_izq_abajo.empuje"] },
    { "eje": { "mando": "lateral/palanca", "valor": 0.0 } },
    { "esperar": 1.5 },
    { "camara": { "en": [4.4, 2.4, 8.4], "mira": [1.57, 1.45, 6.2], "fov": 45 } },
    { "eje": { "mando": "lateral/traslacion", "eje": 1, "valor": -1.0 } },
    { "esperar": 0.3 },
    { "foto": "out/camara/chorros_rcs_traslacion.png" },
    { "volcar": ["rcs_proa_izq_fuera.empuje", "rcs_proa_der_fuera.empuje", "rcs_popa_izq_fuera.empuje", "rcs_popa_der_fuera.empuje"] },
    { "eje": { "mando": "lateral/traslacion", "eje": 1, "valor": 0.0 } },
    // the jets just shut: the snow of what was left in their lines
    { "esperar": 0.1 },
    { "foto": "out/camara/chorros_rcs_apagado.png" },
    // engines stopped: the last of the gas
    { "camara": { "en": [10.5, 0.2, -9.0], "mira": [5.05, -1.0, -4.0], "fov": 50 } },
    { "esperar": 0.4 },
    { "ajustar": { "mando": "pedestal/arr_izq", "valor": 0 } },
    { "ajustar": { "mando": "pedestal/arr_der", "valor": 0 } },
    { "esperar": 0.3 },
    { "foto": "out/camara/chorros_alcotan_apagado.png" },
    { "volcar": ["gondola_izq.empuje", "gondola_izq.estado"] },
    "oir",
    { "esperar": 0.2 }
  ]
}
