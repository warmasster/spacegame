// What holds where one is, wherever that is (docs/MOVIMIENTO.md, 6-9): an Alcotán taken from
// the Moon's ground to orbit, out of the Moon's reach, and to the lesser moon, with the player in
// its cabin and outside it. At each stage `donde` writes to the log which body holds the place
// and how much, what pulls, what the player weighs, how far their own way up is from the ship's,
// and what the compass reads; the pictures (with the HUD) show the compass in each regime.
//   - aboard, the ship's own gravity is the weight and its deck the floor, wherever it is and
//     however it lies (upside down over the Moon included);
//   - the Moon's pull fades to nothing between 20 and 30 km up; past that nothing pulls;
//   - outside the ship with nothing pulling, one floats beside it and nothing turns one;
//   - by the lesser moon it is the lesser moon that holds, ground and north included.
// Run: SeleneV39_debug.exe --guion <this file> → out/camara/espacio_*.png, espacio.log
{
  "registro": "out/camara/espacio.log",
  "naves": ["alcotan"],
  "pasos": [
    { "hud": true },
    { "nave": "alcotan" },
    { "esperar": 1.0 },
    // ---- 1. on the Moon's ground, on foot: north is the Moon's ----
    "jugador",
    { "mirar": [35, -4] },
    { "esperar": 0.5 },
    { "nota": "1. en el suelo de la Luna, a pie, mirando a 35 grados:" },
    "donde",
    { "foto": "out/camara/espacio_1_suelo_luna.png" },
    // ---- 2. in the cabin of the ship, parked ----
    { "ir": [0.6, -0.02, 0.5] },
    { "mirar_a": [0.0, 1.4, 6.0] },
    { "esperar": 2.5 },
    { "nota": "2. de pie en la cabina, la nave posada en la Luna:" },
    "donde",
    { "foto": "out/camara/espacio_2_cabina_posada.png" },
    // ---- 3. the ship in low orbit (12 km up, 1500 m/s): aboard nothing changes ----
    { "poner": { "cuerpo": "luna", "altura": 12000.0, "velocidad": [1500.0, 0.0, 0.0] } },
    { "esperar": 3.0 },
    { "nota": "3. la nave a 12 km de altura y 1500 m/s (en orbita baja), el jugador de pie en la cabina:" },
    "donde",
    { "foto": "out/camara/espacio_3_orbita.png" },
    // ---- 4. the same upside down, and tumbling: the deck is still the floor ----
    { "poner": { "cuerpo": "luna", "altura": 12000.0, "velocidad": [1500.0, 0.0, 0.0], "volcada": 180.0 } },
    { "esperar": 3.0 },
    { "nota": "4. la nave boca abajo sobre la Luna: el jugador sigue de pie en su cubierta:" },
    "donde",
    { "andar": [1, 0] },
    { "esperar": 1.0 },
    { "andar": [0, 0] },
    { "esperar": 0.5 },
    { "nota": "   tras andar 1 s hacia proa:" },
    "donde",
    { "camara": { "en": [0.0, 1.5, -2.6], "mira": [0.6, 1.0, 1.5], "fov": 70 } },
    { "foto": "out/camara/espacio_4_boca_abajo.png" },
    "jugador",
    { "poner": { "cuerpo": "luna", "altura": 12000.0, "velocidad": [1500.0, 0.0, 0.0], "giro": [0.15, 0.1, -0.12] } },
    { "esperar": 4.0 },
    { "nota": "   la nave dando tumbos (0,22 rad/s): sigue de pie:" },
    "donde",
    // ---- 5. out of the Moon's reach: up at 600 m/s from 19 km ----
    { "poner": { "cuerpo": "luna", "altura": 19000.0, "velocidad": [0.0, 0.0, 600.0] } },
    // (in the middle of the cabin, looking across it: the nose and north are not one mark)
    { "ir": [0.6, -0.02, 0.5] },
    { "mirar_a": [-1.3, 1.5, 2.6] },
    { "esperar": 1.0 },
    { "nota": "5. subiendo a 600 m/s desde 19 km: la influencia de la Luna se acaba entre 20 y 30 km:" },
    "donde",
    { "esperar": 4.0 },
    "donde",
    { "esperar": 4.0 },
    { "nota": "   en la franja:" },
    "donde",
    { "foto": "out/camara/espacio_5_franja.png" },
    { "esperar": 4.0 },
    "donde",
    { "esperar": 4.0 },
    "donde",
    { "esperar": 4.0 },
    { "nota": "   fuera de toda influencia:" },
    "donde",
    { "foto": "out/camara/espacio_5_fuera.png" },
    // ---- 6. outside the ship, nothing pulling: floating beside it on the pack ----
    { "ir": [0.5, 3.4, -2.0] },
    { "mirar_a": [0.3, 3.4, 6.0] },
    { "mochila": true },
    { "esperar": 3.0 },
    { "nota": "6. fuera de la nave, sobre su techo, en espacio libre (mochila encendida, manos fuera):" },
    "donde",
    { "esperar": 5.0 },
    { "nota": "   5 s despues (no debe haberse movido ni girado):" },
    "donde",
    { "foto": "out/camara/espacio_6_fuera_de_la_nave.png" },
    { "camara": { "en": [9.0, 6.0, -9.0], "mira": [0.5, 3.6, -1.5], "fov": 55 } },
    { "foto": "out/camara/espacio_6_desde_fuera.png" },
    "jugador",
    { "subir": true },
    { "esperar": 1.0 },
    { "subir": false },
    { "esperar": 3.0 },
    { "nota": "   tras empujar 1 s hacia su propio arriba y soltar, 3 s:" },
    "donde",
    { "mochila": false },
    // ---- 7. to the lesser moon: down into its reach from 7 km over it ----
    { "ir": [0.6, -0.02, 0.5] },
    { "mirar_a": [-1.3, 1.5, 2.6] },
    { "esperar": 1.0 },
    { "poner": { "cuerpo": "luna_menor", "altura": 7000.0, "hacia": [0.0, 1.0, 0.0], "velocidad": [0.0, 0.0, -150.0] } },
    { "esperar": 1.0 },
    { "nota": "7. sobre la luna menor, bajando a 150 m/s desde 7 km: su influencia empieza a 6 km:" },
    "donde",
    { "esperar": 6.0 },
    "donde",
    { "esperar": 6.0 },
    { "nota": "   en su franja:" },
    "donde",
    { "foto": "out/camara/espacio_7_franja_luna_menor.png" },
    { "esperar": 6.0 },
    "donde",
    { "esperar": 6.0 },
    { "nota": "   donde su gravedad es entera:" },
    "donde",
    // ---- 8. set down on it; out on its ground ----
    { "poner": { "cuerpo": "luna_menor", "altura": 6.0, "sobre_suelo": true, "hacia": [0.0, 1.0, 0.0] } },
    { "esperar": 14.0 },
    { "nota": "8. posada en la luna menor, el jugador en la cabina:" },
    "donde",
    { "ir": [9.0, 0.5, 0.0] },
    { "mirar": [35, -4] },
    { "esperar": 12.0 },
    { "nota": "   el jugador fuera, en el suelo de la luna menor, mirando a 35 grados:" },
    "donde",
    { "foto": "out/camara/espacio_8_suelo_luna_menor.png" },
    { "camara": { "en": [22.0, 5.0, 14.0], "mira": [6.0, 0.0, 0.0], "fov": 55 } },
    { "foto": "out/camara/espacio_8_desde_fuera.png" },
    { "esperar": 0.3 }
  ]
}
