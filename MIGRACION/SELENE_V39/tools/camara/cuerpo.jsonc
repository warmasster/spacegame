// The player's own body: standing, walking (each foot on the ground), seen from its own eyes,
// with each tool in its hands, off the ground with the pack.
// Run: luna --guion tools/camara/cuerpo.jsonc → out/camara/cuerpo_*.png
{
  "registro": "out/camara/cuerpo.log",
  "naves": [],
  "pasos": [
    { "esperar": 1.0 },
    { "mirar": [-20, 0] },
    // standing: from ahead and to its left, and from its side
    { "camara_jugador": { "en": [1.6, 1.3, 2.8], "mira": [0, 0.95, 0], "fov": 50 } },
