    // the welder in hand: from its eyes and from outside
    { "equipo": "soldador" },
    { "esperar": 1.0 },
    { "foto": "out/camara/cuerpo_soldador.png" },
    { "mirar": [-20, -30] },
    { "esperar": 0.4 },
    { "foto": "out/camara/cuerpo_soldador_abajo.png" },
    { "mirar": [-20, 0] },
    { "camara_jugador": { "en": [-1.3, 1.5, 1.7], "mira": [-0.1, 1.25, 0.25], "fov": 50 } },
