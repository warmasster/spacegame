    { "esperar": 1.2 },
    { "foto": "out/camara/cuerpo_corre.png" },
    { "correr": false },
    { "andar": [0, 0] },
    { "esperar": 1.2 },
    // from its own eyes: looking down at itself
    { "jugador": null },
    { "mirar": [-20, -62] },
    { "esperar": 0.4 },
    { "foto": "out/camara/cuerpo_mira_abajo.png" },
    { "andar": [1, 0] },
