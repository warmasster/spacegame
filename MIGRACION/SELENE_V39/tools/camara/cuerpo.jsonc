    { "esperar": 0.3 },
    { "foto": "out/camara/cuerpo_busto.png" },
    // walking: from its side, at three moments of the stride
    { "camara_jugador": { "en": [3.2, 0.9, 0.6], "mira": [0, 0.85, 0.5], "fov": 50 } },
