    { "foto": "out/camara/editor_antes.png" },
    { "editar": { "op": "duplicar", "id": "foco_bodega_izq", "nuevo": "foco_bodega_extra", "en": [0.0, 2.5, -5.2] } },
    { "editar": { "op": "girar", "id": "foco_bodega_extra", "rot": [-110, 0, 0] } },
    { "editar": { "op": "cableado", "id": "baliza_sup", "valor": false } },
    "aplicar_edicion",
    { "esperar": 1.5 },
    { "foto": "out/camara/editor_despues.png" }
  ]
