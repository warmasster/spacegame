// The hands with no tool in them: sat in the Alcotán's pilot seat on its stick and throttle,
// reaching for a control as it is worked, gestures on foot, the wrist computer up.
// Run: luna --guion tools/camara/manos_mandos.jsonc → out/camara/manos2_*.png
{
  "registro": "out/camara/manos_mandos.log",
  "naves": ["alcotan"],
  "pasos": [
    { "nave": "alcotan" },
    { "esperar": 2.0 },
    { "linterna": true },
    // sat at the controls: the hands on the stick and the throttle, from the side and from behind
    { "sentar": "piloto" },
    { "esperar": 1.5 },
    { "foto": "out/camara/manos2_sentado_ojos.png" },
    { "camara": { "en": [1.9, 1.5, 5.0], "mira": [0.62, 0.95, 5.0], "fov": 55 } },
    { "foto": "out/camara/manos2_sentado_lado.png" },
    { "camara": { "en": [0.62, 1.75, 3.9], "mira": [0.62, 0.9, 5.2], "fov": 60 } },
    { "foto": "out/camara/manos2_sentado_detras.png" },
    { "camara": { "en": [-0.5, 1.5, 5.0], "mira": [0.62, 0.95, 5.0], "fov": 55 } },
    { "foto": "out/camara/manos2_sentado_otro_lado.png" },
    // a switch of the overhead panel worked: the hand on it
    { "pulsar": "techo/rad" },
    { "foto": "out/camara/manos2_mando_techo_0.png" },
    { "esperar": 0.15 },
    { "foto": "out/camara/manos2_mando_techo.png" },
    { "esperar": 0.2 },
    { "foto": "out/camara/manos2_mando_techo_2.png" },
    { "esperar": 1.5 },
    { "camara": { "en": [0.62, 1.75, 3.9], "mira": [0.62, 1.1, 5.4], "fov": 60 } },
    { "pulsar": "principal/tren" },
    { "esperar": 0.15 },
    { "foto": "out/camara/manos2_mando_principal.png" },
    { "esperar": 0.2 },
    { "foto": "out/camara/manos2_mando_principal_2.png" },
    { "esperar": 1.5 },
    { "jugador": null },
    { "foto": "out/camara/manos2_ojos_despues.png" },
    // on foot outside: gestures, seen from in front
    { "sentar": "" },
    { "ir": [6.0, -1.65, 6.0] },
    { "mirar_a": [6.0, 0.0, 12.0] },
    { "esperar": 1.0 },
    { "camara_jugador": { "en": [0.5, 1.5, 2.6], "mira": [0, 1.25, 0], "fov": 45 } },
    { "gesto": "saludar" },
    { "esperar": 0.9 },
    { "foto": "out/camara/manos2_gesto_saludar.png" },
    { "esperar": 1.6 },
    { "gesto": "pulgar" },
    { "esperar": 1.0 },
    { "foto": "out/camara/manos2_gesto_pulgar.png" },
    { "esperar": 1.2 },
    { "gesto": "senalar" },
    { "esperar": 0.8 },
    { "foto": "out/camara/manos2_gesto_senalar.png" },
    { "gesto": "ok" },
    { "esperar": 1.0 },
    { "foto": "out/camara/manos2_gesto_ok.png" },
    { "esperar": 1.2 },
    { "gesto": "alto" },
    { "esperar": 0.8 },
    { "foto": "out/camara/manos2_gesto_alto.png" },
    { "gesto": "" },
    { "esperar": 0.8 },
    // the wrist computer up: from one's own eyes, and from outside
    { "muneca": true },
    { "esperar": 1.6 },
    { "foto": "out/camara/manos2_muneca_fuera.png" },
    { "jugador": null },
    { "esperar": 0.4 },
    { "foto": "out/camara/manos2_muneca_ojos.png" },
    { "muneca": false }
  ]
}
