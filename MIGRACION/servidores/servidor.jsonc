// Ajustes del servidor de Selene. Se leen al arrancar: después de cambiar algo, para el servidor
// («salir») y vuelve a arrancarlo. Si borras este fichero se usan estos mismos valores.
// Es JSON con comentarios; las comas finales están permitidas.
{
  // Puerto UDP en el que escucha. Es el que hay que abrir en el cortafuegos y en el router
  // para que entren jugadores de fuera (ver LEEME.txt). También: SeleneServidor.exe --puerto 47600
  "puerto": 47600,

  // Nombre del servidor: se le enseña a quien entra. También: --nombre "La Base"
  "nombre": "Servidor de Selene",

  // Jugadores a la vez (de 1 a 64). Al que no cabe se le dice que está lleno.
  "max_jugadores": 16,

  // Veces por segundo que se reparten las posiciones de jugadores y naves (de 5 a 60).
  // Más es más fino y gasta más red; 20 es lo normal.
  "tasa": 20,

  // Segundos sin noticias de un jugador para darlo por caído (de 2 a 300).
  "espera": 10,

  // El servidor tiene la partida: la simula él y decide todo (cada juego predice lo suyo y él lo
  // corrige). Con false solo pasa lo que dice cada juego (la forma antigua). También: --relevo
  "simula": true,

  // Dejar volar libre y poner naves donde se quiera (para pruebas). También: --trucos
  "trucos": false,

  // Dónde se guarda la partida (junto al programa si no es una ruta entera): en dos ranuras,
  // partida.a.bin y partida.b.bin; cada guardado va sobre la más vieja, así que si algo corta uno
  // a medias queda la otra. Al arrancar se retoma la más nueva que esté entera, y quien estaba
  // vuelve a su cuerpo (lo espera 60 s). null: no se guarda. También: --partida RUTA, --sin-guardar;
  // y --nueva para empezar de cero aunque haya una guardada.
  "partida": "partidas/partida",

  // Segundos entre dos guardados (de 10 a 86400); 0 = solo al parar con «salir».
  "guardar_cada": 300,
}
