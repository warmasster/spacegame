    ],
    // INVENTED FOR PLAY (docs/TIEMPOS.md, docs/AIRE.md): a real machine this size sweeps 120 L/s
    // at an isothermal efficiency of 0.65 and takes 34 minutes to empty a 58 m3 hold with its
    // 15 kW. Nobody waits that: it sweeps 2000 L/s at an "efficiency" of 16 (sixteen times what
    // its motor's work would move) and its return line is 22 mm: the hold is empty in 100 s
    "maquina": { "modelo": "compresor", "pieza": "cuerpo",
      "params": { "caudal": "2000 L/s", "potencia": "15 kW", "eficiencia": 16, "etapas": 4, "espacio_muerto": 0.06, "presion_minima": "5 kPa",
