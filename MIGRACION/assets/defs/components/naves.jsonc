// Components ships are fitted with (crates/ship/src/components.rs). Each is one or more convex
// pieces (forma: box size / cylinder radius+height(+taper) / wedge size / hull points), placed in
// the component's frame (+Y up, +Z forward, metres; cylinders stand along +Y, "rot" turns them).
// A component that works brings its default machine ("maquina": model, params; the ship wires its
// ports) and, if it shines, its light ("luz"). "anclajes.puerto": where its stub conduits plug in.
// Every piece is a part: it breaks on its own; the machine lives in the first piece (or "pieza").
{
  // ---------------- furniture ----------------
  // a seat for a crew member in a suit with its pack on (origin on the deck under its column, +z
  // the way the sitter faces): the pan ("cojin": its pad's top at y 0.46 under the thighs, its
  // shell on behind as a shelf under the pack), a cradle for the pack instead of a back
  // ("respaldo": an upright plate behind the pack, which reaches back to z -0.49), a helmet rest
  // over the pack ("cabeza"), an armrest each side outside the thighs
  "asiento": {
    "nombre": "Asiento",
    "material": "aluminio",
    "piezas": [
      { "id": "base", "acabado": "pintura", "forma": { "kind": "box", "size": [0.46, 0.36, 0.46] }, "en": [0, 0.18, 0], "color": [58, 60, 66] },
      { "id": "cojin", "acabado": "tela", "forma": { "kind": "box", "size": [0.6, 0.1, 0.83] }, "en": [0, 0.41, -0.125], "material": "goma", "color": [44, 52, 66] },
      { "id": "respaldo", "acabado": "tela", "forma": { "kind": "box", "size": [0.64, 1.0, 0.1] }, "en": [0, 0.95, -0.555], "material": "goma", "color": [44, 52, 66] },
      { "id": "cabeza", "acabado": "tela", "forma": { "kind": "box", "size": [0.36, 0.12, 0.26] }, "en": [0, 1.5, -0.42], "material": "goma", "color": [36, 42, 54] },
      { "id": "brazo_i", "acabado": "goma", "forma": { "kind": "box", "size": [0.06, 0.18, 0.38] }, "en": [0.31, 0.56, 0.01], "color": [70, 72, 78] },
      { "id": "brazo_d", "acabado": "goma", "forma": { "kind": "box", "size": [0.06, 0.18, 0.38] }, "en": [-0.31, 0.56, 0.01], "color": [70, 72, 78] }
    ]
  },
  "consola_puente": {
    "nombre": "Consola de vuelo",
    "material": "aluminio",
    "piezas": [
      { "id": "cuerpo", "acabado": "pintura", "hueco": 0.004, "forma": { "kind": "box", "size": [2.5, 0.72, 0.5] }, "en": [0, 0.36, 0.12], "color": [64, 66, 72], "chapa": 0.6 },
      { "id": "cara", "forma": { "kind": "box", "size": [2.42, 0.05, 0.7] }, "en": [0, 0.92, -0.02], "rot": [-53, 0, 0], "material": "electronica", "color": [46, 48, 52] },
      { "id": "visera", "acabado": "plastico", "forma": { "kind": "box", "size": [2.3, 0.05, 0.3] }, "en": [0, 1.22, 0.16], "rot": [12, 0, 0], "color": [38, 40, 44] }
