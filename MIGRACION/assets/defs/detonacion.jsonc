// How a conventional explosive goes off (core/src/detonation.rs). An explosion, shot or missile
// that has "charge": { "tnt": kg, "casing": kg } is made from these laws; nothing else to write.
// W = kg of TNT (plus an impact's energy). Blast: lengths x W^(1/3), times x W^(1/6).
// Ground: crater radius R = k W^(1/3) (g_ref / g)^(1/6); a layer in "crater" units has its size,
// spread and lift in R, its speed in sqrt(g R) and its life in T = sqrt(R / g) (Moon, 730 kg:
// R = 9 m, sqrt(g R) = 3.8 m/s, T = 2.4 s), so ejecta land a few crater radii out on any world.
{
  "tnt_energy": 4.184e6,
  // a simple crater (core/src/deform.rs): depth in R, a fifth of the diameter as fresh lunar ones
  // (Pike 1977); rim in depths, a quarter: what the bowl loses is what its (r/R)^-3 ejecta blanket
  // holds (McGetchin 1973). It can wait `delay` T (0: at once, under the glow and the dust).
  "crater": { "k": 1.0, "g_ref": 1.62, "depth": 0.4, "rim": 0.25, "delay": 0.0 },
  "flash": { "color": [1.0, 0.71, 0.42], "intensity": 30.0, "range": 36.0, "duration": 0.43, "lift": 0.5, "max_intensity": 900.0 },
  // camera jitter (rad) never over max_amplitude, however big the charge
  "shake": { "amplitude": 0.005, "range": 78.0, "duration": 0.5, "max_amplitude": 0.09 },
  // share of the energy that reaches structures; reach (m) per W^(1/3)
  "damage": { "share": 0.066, "reach": 5.0 },
  // count = n x (kg of `of`: "explosive", the default, or "casing")^(1/3), at most max; power:
  // most launch slow, a few fast (Pareto), as ejecta leave a crater; ground: only for a blast on
  // the ground. Only soft dust and sparks: hard or streaked chunks read as balls (no layer uses
  // the casing for now).
  "layers": [
    // the bright heart (one glow, under the crater's size; the bomb's, 6 m, fades from 6 to 10 km)
    { "style": "brillo", "count": 10.0, "max": 1, "speed": [0.0, 0.0], "cone": 0.0, "size": [0.7, 0.7], "life": [0.4, 0.55], "lift": 0.5 },
    // the burst of dust that swallows the blast point (and the crater being dug under it)
    { "style": "nucleo", "count": 6.0, "max": 50, "speed": [0.6, 2.4], "cone": 80.0, "size": [0.5, 0.9], "life": [0.6, 1.1], "spread": 0.35, "lift": 0.3 },
    // a sheet of dust racing out along the ground, two or three crater radii
    { "style": "falda", "count": 11.0, "max": 110, "ground": true, "speed": [2.0, 5.0], "cone": 90.0, "tilt": 85.0, "size": [0.35, 0.7], "life": [2.2, 4.0], "spread": 0.6, "lift": 0.08 },
    // the ejecta curtain: an inverted cone of regolith on ballistic arcs
    { "style": "polvo", "count": 33.0, "max": 420, "ground": true, "speed": [1.0, 12.0], "power": 0.6, "cone": 60.0, "tilt": 42.0, "size": [0.08, 0.2], "life": [3.0, 6.0], "spread": 0.55 },
    // hot sparks of the burn: real sparks whatever the charge (sizes, m/s and s as written; only
    // their number grows)
    { "style": "chispas", "count": 10.0, "max": 100, "scale": "absolute", "speed": [8.0, 30.0], "cone": 75.0, "size": [0.03, 0.07], "life": [0.5, 1.8], "lift": 0.3 },
  ],
}
