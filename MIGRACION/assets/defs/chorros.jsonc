// Exhaust: how what leaves a thruster looks (crates/core/src/plumes.rs, docs/CHORROS.md).
//
// A machine that pushes gets the style its data names ("chorro": { "estilo": ... } in its
// "maquina"), else the one of its model (por_modelo). A new engine is data: nothing here knows a
// ship. In a vacuum a plume is no flame: a bright mouth and a faint cone that opens wide and is
// gone within a few metres.
//
// A style:
//   nucleo, pluma   light of the hot gas at the nozzle's mouth and of the cone (linear, HDR)
//   largo           length of the cone (m) per root of kN of thrust (48 kN: x 6.9; 2.2 kN: x 1.5)
//   apertura        half-angle of its edge (degrees)
//   nucleo_largo    how far along the cone the core reaches (share of its length; 0.12)
//   nucleo_ancho    how wide the core is (nozzle radii; 0.8)
//   caida           how fast the cone thins as it opens (1.3)
//   parpadeo        flicker, 0 steady .. 1 (0); corriente: how fast its streaks run (lengths/s; 3)
//   sol             share of its light that is the sun's on it: frost and cold gas, dark in shadow
//   gamma           its light goes with the throttle to this power (0.6)
//   desvanecer      seconds it takes to go out when the thrust stops (0.08)
//   luz             what it lights round it: sRGB colour, intensity, range (m per root of kN)
//   arranque, apagado   gas thrown as it starts and as it stops: "cuantas" particles of "estilo"
//                   (particles.jsonc), speed (lengths/s), cone (deg), size (lengths), life (s)
//   particulas      gas thrown all the while: the same with "por_segundo" at full thrust
// (lengths: the cone's length at full thrust)
{
  "por_modelo": { "motor_cohete": "motor", "rcs": "rcs" },

  // the suit's pack: its nozzles are the suit's points (rigs/astronauta.jsonc, "puntos") whose
  // name starts so; each answers a push when its jet leaves within "cono" degrees of the way
  // against it
  "mochila": { "estilo": "gas_mochila", "toberas": "tobera_", "radio": 0.02, "cono": 60.0 },

  "estilos": {
    // a rocket engine: white-hot at the mouth, a thin bluish cone; a puff of unburnt
    // propellant as it lights, another as the chamber empties
    "motor": {
      "nucleo": [10.0, 9.0, 8.5], "pluma": [0.4, 0.55, 0.95],
      "largo": 1.1, "apertura": 26.0,
      "nucleo_largo": 0.07, "nucleo_ancho": 0.6, "caida": 0.9,
      "parpadeo": 0.25, "corriente": 4.0, "desvanecer": 0.12,
      "luz": { "color": [255, 226, 196], "intensidad": 3.0, "alcance": 1.7 },
      "arranque": { "estilo": "bocanada", "cuantas": 10, "velocidad": [0.8, 2.2], "cono": 30.0, "tamano": [0.035, 0.08], "vida": [0.35, 0.8] },
      "apagado": { "estilo": "bocanada", "cuantas": 5, "velocidad": [0.3, 1.0], "cono": 35.0, "tamano": [0.03, 0.06], "vida": [0.4, 0.9] }
    },
    // a reaction control jet: a short sharp pale cone while it fires, and the snow of what
    // was left in its lines when it shuts
    "rcs": {
      "nucleo": [5.0, 5.0, 5.6], "pluma": [1.5, 1.7, 2.3],
      "largo": 1.4, "apertura": 22.0,
      "nucleo_largo": 0.12, "nucleo_ancho": 0.6, "caida": 1.0,
      "parpadeo": 0.2, "corriente": 6.0, "desvanecer": 0.06, "gamma": 0.35,
      "luz": { "color": [235, 240, 255], "intensidad": 0.9, "alcance": 1.2 },
      "apagado": { "estilo": "bocanada", "cuantas": 3, "velocidad": [0.6, 1.8], "cono": 40.0, "tamano": [0.06, 0.12], "vida": [0.25, 0.6] }
    },
    // cold gas (a tug's nozzles): no fire, only the gas freezing as it opens, seen by the sun
    // on it; crystals glinting along it
    "gas_frio": {
      "nucleo": [0.6, 0.66, 0.8], "pluma": [0.5, 0.56, 0.72],
      "largo": 1.5, "apertura": 30.0,
      "nucleo_largo": 0.2, "nucleo_ancho": 1.0, "caida": 0.9,
      "parpadeo": 0.35, "corriente": 5.0, "sol": 0.85, "desvanecer": 0.1,
      "particulas": { "estilo": "escarcha", "por_segundo": 30.0, "velocidad": [2.5, 5.0], "cono": 26.0, "tamano": [0.012, 0.028], "vida": [0.2, 0.45] },
      "apagado": { "estilo": "bocanada", "cuantas": 2, "velocidad": [0.6, 1.6], "cono": 40.0, "tamano": [0.07, 0.13], "vida": [0.25, 0.5] }
    },
    // the suit's pack: the same gas from smaller nozzles, in puffs
    "gas_mochila": {
      "nucleo": [0.9, 1.0, 1.2], "pluma": [0.5, 0.58, 0.75],
      "largo": 1.3, "apertura": 26.0,
      "nucleo_largo": 0.2, "nucleo_ancho": 1.4, "caida": 0.7,
      "parpadeo": 0.4, "corriente": 5.0, "sol": 0.85, "desvanecer": 0.1,
      "particulas": { "estilo": "bocanada", "por_segundo": 40.0, "velocidad": [3.0, 6.0], "cono": 22.0, "tamano": [0.04, 0.08], "vida": [0.15, 0.35] }
    }
  }
}
