  // ------------------------------------------------------------------ closures
  // Everything that shuts an opening, made one way (crates/ship/src/closures.rs): the leaf takes
  // the opening's outline with an overlap, a seal goes round it, latches pull it shut the last
  // few degrees and hold it. Closed at 0, open at its limit: <id>.abierta, <id>.cerrada.
  "cierres": [
    { "id": "rampa", "nombre": "Rampa", "abertura": { "tipo": "mamparo", "mamparo": "popa", "lado": -1 },
      "mueve": { "tipo": "bisagra", "borde": "abajo", "angulo": 124 },
