      "hoja": { "espesor": 0.05, "color": [190, 120, 40], "chapa": 0.5 }, "entre": ["bodega", "cabina"], "orden": "puerta_bodega.orden" },
    { "id": "puerta_puente", "nombre": "Puerta del puente", "abertura": { "tipo": "mamparo", "mamparo": "mamparo_puente", "lado": -1 },
      "mueve": { "tipo": "corredera", "hacia": [1, 0, 0], "hojas": 2 },
