      "abierta": true, "entre": ["bodega", "vacio"], "orden": "rampa.orden", "amortiguamiento": 900 },
    { "id": "puerta_bodega", "nombre": "Puerta de la bodega", "abertura": { "tipo": "mamparo", "mamparo": "mamparo_bodega", "lado": 1 },
