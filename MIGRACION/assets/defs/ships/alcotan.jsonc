    "aire": {
      "medio": "aire", "nominal": "350 Pa", "conducto": "conducto",
      "nodos": { "plenum": [-0.55, 2.72, -3.0], "cab_b": [-0.55, 2.76, -1.4], "cab_a": [-0.55, 2.76, 0.6], "proa": [-0.55, 2.62, 2.4],
                 "puente_a": [-0.55, 2.48, 3.05], "bod_b": [-0.55, 2.76, -4.6], "bod_a": [-0.55, 2.76, -7.0] },
      "tramos": [
        { "de": "plenum", "a": "cab_b" }, { "de": "cab_b", "a": "cab_a" }, { "de": "cab_a", "a": "proa" }, { "de": "proa", "a": "puente_a" },
        { "de": "plenum", "a": "bod_b" }, { "de": "bod_b", "a": "bod_a" }
      ]
    },
    "o2": {
      "medio": "gas", "nominal": "800 kPa", "conducto": "tubo", "color": [235, 235, 232], "fuga": "0.05 kg/s",
      "nodos": { "botellas": [-1.75, 1.3, -4.7], "salida": [0.45, 2.38, -3.18], "bodega": [-1.75, 1.75, -5.3] },
      "tramos": [ { "de": "botellas", "a": "salida" }, { "de": "botellas", "a": "bodega" } ]
    },
    "n2": {
      "medio": "gas", "nominal": "800 kPa", "conducto": "tubo", "color": [40, 40, 44], "fuga": "0.05 kg/s",
      "nodos": { "botella": [-1.75, 1.3, -4.2], "salida": [-0.45, 2.38, -3.18], "bodega": [-1.75, 1.75, -5.65] },
      "tramos": [ { "de": "botella", "a": "salida" }, { "de": "botella", "a": "bodega" } ]
    }
  },

  // ------------------------------------------------------------------ compartments
  "compartimentos": [
    // each with its own panel (atmosphere, pressure, its doors, lights, hull, power: `rooms`)
    { "id": "puente", "nombre": "Puente", "cajas": [[[-1.7, 0, 2.6], [1.7, 2.6, 6.9]]], "volumen": 20, "presion": "70 kPa",
      "panel": { "en": [1.1, 1.45, 2.712], "normal": [0, 0, 1], "energia": "elec:c_soporte" },
      "represurizar": { "o2": "o2", "n2": "n2" } },
    { "id": "cabina", "nombre": "Cabina", "cajas": [[[-2.0, 0, -3.4], [2.0, 2.95, 2.6]]], "volumen": 60, "presion": "70 kPa",
      "panel": { "en": [-0.98, 1.45, 2.488], "normal": [0, 0, -1], "energia": "elec:c_soporte" },
      "represurizar": { "o2": "o2", "n2": "n2" } },
    { "id": "bodega", "nombre": "Bodega", "cajas": [[[-2.0, 0, -9.3], [2.0, 2.95, -3.4]]], "volumen": 58,
      "aberturas": [ { "senal": "bodega.venteo", "area": 0.09 } ],
      "panel": { "en": [1.938, 1.45, -4.45], "normal": [-1, 0, 0], "energia": "elec:c_soporte" } }
  ],

  // ------------------------------------------------------------------ panels
  "paneles": [
    { "id": "principal", "panel": "alc_principal", "pieza": "consola.cara", "en": [0, 0.935, 5.71], "normal": [0, 0.6, -0.8], "energia": "elec:c_pantallas",
      "prefijo": { "emp_max": "55", "emp_min": "15", "emp_nom": "48", "emp_rojo": "50" } },
    { "id": "pedestal", "panel": "alc_pedestal", "pieza": "pedestal.cara", "en": [0, 0.662, 5.02], "normal": [0, 1, 0], "arriba": [0, 0, 1], "energia": "elec:c_pantallas" },
    { "id": "techo", "panel": "alc_techo", "pieza": "techo_puente", "en": [0, 2.0218, 5.3005], "normal": [0, -0.9272, -0.3746], "arriba": [0, 0.3746, -0.9272], "energia": "elec:c_pantallas" },
    { "id": "lateral", "panel": "alc_lateral", "pieza": "lateral_piloto", "en": [1.12, 0.662, 5.0], "normal": [0, 1, 0], "arriba": [0, 0, 1], "datos": "datos:lateral" },
    { "id": "combustible", "panel": "alc_combustible", "pieza": "lateral_copiloto", "en": [-1.12, 0.662, 5.0], "normal": [0, 1, 0], "arriba": [0, 0, 1], "energia": "elec:c_pantallas" },
    // (without the breakers of circuits it does not have: a crane, momentum wheels)
    { "id": "disyuntores", "panel": "alc_disyuntores", "sin": ["grua", "giro"], "en": [1.938, 1.45, -2.95], "normal": [-1, 0, 0], "energia": "elec:c_pantallas" },
    { "id": "soporte", "panel": "alc_soporte", "en": [-1.938, 1.45, -2.95], "normal": [1, 0, 0], "energia": "elec:c_soporte" },
    // the electrical balance (generation, consumption, batteries): the generic "energia" panel,
    // on the cabin's port wall forward of the seats
    { "id": "energia", "panel": "energia", "en": [1.938, 1.5, -0.6], "normal": [-1, 0, 0], "energia": "elec:c_pantallas" },
    { "id": "reactor", "panel": "alc_reactor", "en": [-1.938, 1.55, -7.3], "normal": [1, 0, 0], "energia": "elec:c_reactor" },
    { "id": "rampa_bodega", "panel": "alc_rampa", "en": [1.908, 1.35, -8.85], "normal": [-1, 0, 0], "prefijo": { "aqui": "rampa_bodega" }, "energia": "elec:c_rampa" },
    { "id": "rampa_ext", "panel": "alc_rampa", "sin": ["focos"], "en": [1.78, 0.95, -9.462], "normal": [0, 0, -1], "prefijo": { "aqui": "rampa_ext" }, "energia": "elec:c_rampa" },
    { "id": "puerta_bodega_h", "panel": "alc_puerta", "en": [-1.2, 1.3, -3.512], "normal": [0, 0, -1], "prefijo": { "aqui": "puerta_bodega_h", "puerta": "puerta_bodega" }, "energia": "elec:c_puertas" },
    { "id": "puerta_bodega_c", "panel": "alc_puerta", "en": [1.2, 1.3, -3.288], "normal": [0, 0, 1], "prefijo": { "aqui": "puerta_bodega_c", "puerta": "puerta_bodega" }, "energia": "elec:c_puertas" },
    { "id": "puerta_puente_c", "panel": "alc_puerta", "en": [1.1, 1.3, 2.488], "normal": [0, 0, -1], "prefijo": { "aqui": "puerta_puente_c", "puerta": "puerta_puente" }, "energia": "elec:c_puertas" },
    { "id": "puerta_puente_p", "panel": "alc_puerta", "en": [-1.1, 1.3, 2.712], "normal": [0, 0, 1], "prefijo": { "aqui": "puerta_puente_p", "puerta": "puerta_puente" }, "energia": "elec:c_puertas" }
  ],

  // ------------------------------------------------------------------ seats
  // where one gets off a seat when its own way out is taken: the bridge's floor astern of the
  // pilots, the aisle between the cabin's seats
  "bajadas": [
    { "id": "puente", "en": [0, 0, 3.5], "zona": [1.8, 1.2] },
    { "id": "cabina", "en": [0, 0, -1.9], "zona": [0.6, 2.4] }
  ],
  "asientos": [
    { "id": "piloto", "nombre": "Asiento del piloto", "pieza": "asiento_piloto.cojin", "ojos": [0.62, 1.35, 4.82], "rumbo": 0, "salida": [0.0, 0.0, 3.6],
      "paneles": ["principal", "pedestal", "techo", "lateral"],
      "mandos": [
        { "orden": "cabecear_abajo", "mando": "lateral/palanca", "eje": 0, "valor": 1.0, "ayuda": "Palanca de mando: cabeceo (morro abajo y arriba)" },
        { "orden": "cabecear_arriba", "mando": "lateral/palanca", "eje": 0, "valor": -1.0, "ayuda": "Palanca de mando: cabeceo (morro abajo y arriba)" },
        { "orden": "alabear_derecha", "mando": "lateral/palanca", "eje": 1, "valor": 1.0, "ayuda": "Palanca de mando: alabeo (inclinarse a un lado y a otro)" },
        { "orden": "alabear_izquierda", "mando": "lateral/palanca", "eje": 1, "valor": -1.0, "ayuda": "Palanca de mando: alabeo (inclinarse a un lado y a otro)" },
        { "orden": "guinar_izquierda", "mando": "lateral/guinada", "eje": 0, "valor": 1.0, "ayuda": "Guiñada (girar el morro a izquierda y derecha)" },
        { "orden": "guinar_derecha", "mando": "lateral/guinada", "eje": 0, "valor": -1.0, "ayuda": "Guiñada (girar el morro a izquierda y derecha)" },
        { "orden": "subir", "mando": "lateral/vertical", "eje": 0, "valor": 1.0, "ayuda": "Subir y bajar con los propulsores de maniobra" },
        { "orden": "bajar", "mando": "lateral/vertical", "eje": 0, "valor": -1.0, "ayuda": "Subir y bajar con los propulsores de maniobra" },
        { "orden": "avanzar", "mando": "lateral/traslacion", "eje": 0, "valor": 1.0, "ayuda": "Traslación adelante y atrás (propulsores de maniobra)" },
        { "orden": "retroceder", "mando": "lateral/traslacion", "eje": 0, "valor": -1.0, "ayuda": "Traslación adelante y atrás (propulsores de maniobra)" },
        { "orden": "desplazar_izquierda", "mando": "lateral/traslacion", "eje": 1, "valor": 1.0, "ayuda": "Traslación a los lados (propulsores de maniobra)" },
        { "orden": "desplazar_derecha", "mando": "lateral/traslacion", "eje": 1, "valor": -1.0, "ayuda": "Traslación a los lados (propulsores de maniobra)" },
        { "orden": "gases_mas", "mando": "pedestal/acelerador", "accion": "subir", "ayuda": "Acelerador de los motores: más" },
        { "orden": "gases_menos", "mando": "pedestal/acelerador", "accion": "bajar", "ayuda": "Acelerador de los motores: menos" },
        { "orden": "gases_cero", "mando": "pedestal/acelerador", "accion": "cero", "ayuda": "Acelerador de los motores: a cero" }
      ] },
    { "id": "copiloto", "nombre": "Asiento del copiloto", "pieza": "asiento_copiloto.cojin", "ojos": [-0.62, 1.35, 4.82], "rumbo": 0, "salida": [0.0, 0.0, 3.6],
      "paneles": ["principal", "pedestal", "techo", "combustible"] },
    { "id": "cabina_1", "nombre": "Asiento de cabina", "pieza": "asiento_c1.cojin", "ojos": [1.28, 1.35, -2.3], "rumbo": -90, "salida": [0.4, 0.0, -2.3] },
    { "id": "cabina_2", "nombre": "Asiento de cabina", "pieza": "asiento_c2.cojin", "ojos": [1.28, 1.35, -1.5], "rumbo": -90, "salida": [0.4, 0.0, -1.5] },
    { "id": "cabina_3", "nombre": "Asiento de cabina", "pieza": "asiento_c3.cojin", "ojos": [-1.28, 1.35, -2.3], "rumbo": 90, "salida": [-0.4, 0.0, -2.3] },
    { "id": "cabina_4", "nombre": "Asiento de cabina", "pieza": "asiento_c4.cojin", "ojos": [-1.28, 1.35, -1.5], "rumbo": 90, "salida": [-0.4, 0.0, -1.5] }
  ],

  // ------------------------------------------------------------------ logic
  "senales": { "aire.consigna": "70 kPa" },
  "derivadas": {
    "rampa.orden": "!toggle(rampa_bodega.rampa || rampa_ext.rampa)",
    "puerta_bodega.orden": "toggle(puerta_bodega_h.boton || puerta_bodega_c.boton)",
    "puerta_puente.orden": "toggle(puerta_puente_c.boton || puerta_puente_p.boton)",
    "puerta_bodega.dp": "abs(cabina.p - bodega.p)",
    // the hold's vent and make-up gas from the life support panel too (its own panel adds its side)
    "bodega.venteo": "bodega.venteo_soporte || rampa_bodega.venteo || rampa_ext.venteo",
    "bodega.repres": "bodega.repres_soporte",
    "puerta_puente.dp": "abs(puente.p - cabina.p)",
    "luces.emergencia": "elec.bus_a < 22 V && elec.bus_ess > 18 V",
    "luces.focos_bodega": "rampa_bodega.focos",
    "tren.verde_i": "act_tren_izq.bloqueado && tren_izq.pos > 0.95",
    "tren.verde_d": "act_tren_der.bloqueado && tren_der.pos < 0.05",
    "tren.verde_m": "act_tren_morro.bloqueado && tren_morro.pos < 0.05",
    "alarma.tren": "for(tren.orden && !(tren.verde_i && tren.verde_d && tren.verde_m), 20 s) || (!tren.orden && nave.altura < 15 m && nave.vs < -1 m/s)",
    "alarma.disyuntor": "!(brk.luces_cab && brk.luces_bod && brk.puertas && brk.rampa && brk.hid_a && brk.soporte && brk.refrig && brk.compresor && brk.luces_puente && brk.luces_ext && brk.hid_b && brk.gondolas && brk.tren && brk.motores && brk.rcs && brk.reactor && brk.radiadores && brk.antena && brk.apu && brk.emergencia && brk.avionica && brk.pantallas)",
    "alarma.algo": "elec.bus_a < 22 V || elec.bus_b < 22 V || ((hid.a || hid.b) && hid.colector < 12 MPa) || alarma.tren || alarma.disyuntor || reactor.estado == 3 || cabina.p < 60 kPa || gondola_izq.estado == 6 || gondola_der.estado == 6 || deposito_izq.fuga > 0.05 || deposito_der.fuga > 0.05",
    "alarma.general": "latch(edge(alarma.algo), panel.reconocer)",
    // what it sounds with: `sonido.<id>` is the level of loop <id> (assets/defs/sounds.jsonc) for
    // whoever is aboard. The master alarm, while there is something to feed its horn
    "sonido.alarma": "alarma.general && elec.bus_ess > 18 V",
    // its own gravity works while there is something to feed its plates
    "abordo.gravedad": "elec.bus_ess > 18 V"
  },
  // the priority of every circuit (BAJA / NORMAL / ALTA), on the hold's port wall by the hydraulics
  "prioridades": { "en": [1.938, 1.55, -6.1], "normal": [-1, 0, 0], "energia": "elec:c_soporte" },
  // ------------------------------------------------------------------ air moved on purpose
  // (crates/ship/src/airworks.rs, docs/AIRE.md)
  "trasvase": {
    // hand valves through the walls: a wheel and a gauge of the pressure across on each side
    // that is a compartment ("normal": the way from the first of "entre" to the second). Between
    // hold and cabin, between cabin and bridge, and out of the hold by the ramp for the last of
    // its air, which the compressor does not reach
    // ("paso": what they pass wide open, as the bore of an orifice. More than their bodies
    // could: so that two rooms are level in a quarter of a minute — docs/TIEMPOS.md)
    "valvulas": [
      { "id": "vi_bodega", "entre": ["bodega", "cabina"], "en": [-1.5, 0.93, -3.4], "normal": [0, 0, 1], "paso": "150 mm" },
      { "id": "vi_puente", "entre": ["cabina", "puente"], "en": [1.5, 0.93, 2.6], "normal": [0, 0, 1], "paso": "150 mm" },
      { "id": "vv_bodega", "entre": ["bodega", "vacio"], "en": [1.72, 1.5, -9.3], "normal": [0, 0, -1], "paso": "170 mm" }
    ],
    // the compressor's panel, made from what its manifold reaches: on the hold's port wall, over it
    "compresores": [
      { "id": "compresor_aire", "panel": { "en": [1.938, 1.55, -7.9], "normal": [-1, 0, 0], "energia": "elec:c_soporte" } }
    ]
  },
  "enclavamientos": [
    { "mando": "principal/tren", "hacia": 0, "si": "nave.altura < 2 m", "motivo": "Peso sobre el tren" },
    { "mando": "rampa_bodega/rampa", "si": "bodega.p > 3 kPa && rampa.cerrada > 0.5", "motivo": "Bodega presurizada: ventéala antes (panel de soporte vital)" },
    { "mando": "rampa_ext/rampa", "si": "bodega.p > 3 kPa && rampa.cerrada > 0.5", "motivo": "Bodega presurizada" },
    { "mando": "puerta_bodega_h/abrir", "si": "puerta_bodega.dp > 5 kPa && puerta_bodega.cerrada > 0.5", "motivo": "Diferencia de presión con la cabina" },
    { "mando": "puerta_bodega_c/abrir", "si": "puerta_bodega.dp > 5 kPa && puerta_bodega.cerrada > 0.5", "motivo": "Diferencia de presión con la bodega" },
    { "mando": "puerta_puente_c/abrir", "si": "puerta_puente.dp > 5 kPa && puerta_puente.cerrada > 0.5", "motivo": "Diferencia de presión con el puente" },
    { "mando": "puerta_puente_p/abrir", "si": "puerta_puente.dp > 5 kPa && puerta_puente.cerrada > 0.5", "motivo": "Diferencia de presión con la cabina" }
  ],
  // What it keeps whatever one conduit is lost (a piece of trunk, an outlet, a duct): every run
  // goes two ways round the rooms, every junction sits between two pieces of trunk, and the
  // sources are spread (battery 1 and converter A aft to port, battery 2 in the cabin and converter
  // B forward to starboard, the APU aft overhead). `tests/fallo_unico.rs` cuts each in turn.
  "esenciales": {
    "Un bus principal con tensión": "elec.bus_a > 20 V || elec.bus_b > 20 V",
    "Bus esencial": "elec.bus_ess > 20 V",
    "Aviónica": "elec.c_avionica > 20 V",
    "Pantallas e indicadores": "elec.c_pantallas > 20 V",
    "Luces de emergencia": "elec.c_emerg > 20 V",
    "Soporte vital": "elec.c_soporte > 20 V",
    "Bombas de refrigerante del reactor": "elec.c_refrig > 20 V",
    "Control del reactor": "elec.c_reactor > 20 V",
    "Puertas": "elec.c_puertas > 20 V",
    "Una bomba hidráulica": "elec.c_hid_a > 20 V || elec.c_hid_b > 20 V",
    "Una batería en la barra": "bateria_1.soc > 0.05 && elec.bat1 > 20 V || bateria_2.soc > 0.05 && elec.bat2 > 20 V"
  },
  "alarmas": {
    "Bus A sin tensión": "elec.bus_a < 20 V",
    "Bus B sin tensión": "elec.bus_b < 20 V",
    "Presión hidráulica baja": "(hid.a || hid.b) && hid.colector < 10 MPa",
    "SCRAM del reactor": "reactor.estado == 3",
    "Reactor limitado por temperatura: da menos de lo pedido (despliega los radiadores o baja la potencia)": "reactor.limitado",
    "Descompresión en la cabina": "cabina.fuga > 2 kPa",
    "Descompresión en el puente": "puente.fuga > 2 kPa",
    "Fuga de propelente": "deposito_izq.fuga > 0.05 || deposito_der.fuga > 0.05",
    "Motor izquierdo: fallo": "gondola_izq.estado == 6",
    "Motor derecho: fallo": "gondola_der.estado == 6",
    "Tren sin blocar": "alarma.tren"
  },

  // Gravity aboard: what whoever it carries weighs (standing on it or in its rooms), toward its
  // decks, wherever it is and however it flies: 1.62 m/s² while the essential bus is fed
  // ("abordo.gravedad" below), coming on and going over 2 s. With the ship dead one weighs
  // aboard what is left of the world's pull (nothing in free fall)
  "gravedad": { "g": 1.62, "senal": "abordo.gravedad", "tiempo": 2.0 },
  "vuelo": {
    "cabeceo": "vuelo.cabeceo", "alabeo": "vuelo.alabeo", "guinada": "vuelo.guinada",
    "traslacion": ["vuelo.tx", "vuelo.ty", "vuelo.tz"], "acelerador": "vuelo.acelerador",
    "estabilizador": "vuelo.sas", "mantener": "vuelo.mantener",
    "giro": [30, 35, 40], "ganancia": 2.5,
    "rcs": ["rcs_*"], "motores": ["gondola_izq", "gondola_der"], "ordenador": "ordenador"
  }
}
