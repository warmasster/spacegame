      "medio": "propelente", "nominal": "2.4 MPa", "conducto": "tubo", "fuga": "3 kg/s",
      "nodos": { "t_izq": [3.1, 1.03, -2.6], "t_der": [-3.1, 1.03, -2.6], "t_izq_k": [2.2, 1.05, -3.7], "t_der_k": [-2.2, 1.05, -3.7],
