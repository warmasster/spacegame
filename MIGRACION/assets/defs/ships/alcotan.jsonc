// ALCOTÁN — VTOL service shuttle (crates/ship, docs/NAVES.md). Ship frame: +Y up, nose toward +Z,
// +X to port (left), metres; the deck is y = 0. Everything is a part: every hull panel, deck plate,
// bulkhead piece, component piece, every cable, pipe and duct segment and every device's own stub.
// Networks run through those conduits: cut one and what is beyond it stops.
{
  "nombre": "Alcotán",
  "matricula": "ALC-07",
  "clase": "Lanzadera de servicio VTOL",
  "astillero": "Astilleros Orell",
  "modelo": "Orell AL-7",
  "descripcion": "Lanzadera de 20 m con góndolas basculantes, bodega con rampa, reactor compacto y tres patas hidráulicas.",

  // ------------------------------------------------------------------ hull
  "casco": {
    "material": "panel_casco",
    "espesor": 0.07,
    "chapa": 0.85,
    // outline (outer skin), counter-clockwise seen from the nose, from the keel
    "perfiles": {
      "casco": [[0.0, -0.65], [1.35, -0.6], [2.0, -0.2], [2.15, 0.9], [2.0, 2.2], [1.3, 2.85], [0.0, 3.0],
                [-1.3, 2.85], [-2.0, 2.2], [-2.15, 0.9], [-2.0, -0.2], [-1.35, -0.6]]
    },
    "suaves": [0, 3, 6, 9],
    "estaciones": [
      { "z": -9.3, "perfil": "casco", "escala": [0.97, 0.96], "compartimento": "bodega", "divisiones": 2 },
      { "z": -6.6, "perfil": "casco", "escala": [0.99, 0.99], "compartimento": "bodega" },
      { "z": -5.0, "perfil": "casco", "compartimento": "bodega" },
      { "z": -3.4, "perfil": "casco", "compartimento": "cabina", "divisiones": 2 },
      { "z": -0.2, "perfil": "casco", "compartimento": "cabina", "divisiones": 2 },
      { "z": 2.6, "perfil": "casco", "escala": [0.98, 0.98], "compartimento": "puente" },
      { "z": 4.2, "perfil": "casco", "escala": [0.9, 0.88], "y": 0.04, "compartimento": "puente" },
      { "z": 5.6, "perfil": "casco", "escala": [0.76, 0.74], "y": 0.1, "compartimento": "puente" },
      { "z": 6.9, "perfil": "casco", "escala": [0.58, 0.56], "y": 0.16 },
      { "z": 8.4, "perfil": "casco", "escala": [0.32, 0.3], "y": 0.3 },
      { "z": 9.4, "perfil": "casco", "escala": [0.1, 0.08], "y": 0.45 }
    ],
    // the belly is under the deck: it bounds no compartment (the deck does)
    "bajo_suelo": [0, 1, 10, 11],
    // canopy and cabin windows: (station interval, facet)
    "ventanas": [
      [4, 3], [4, 8],
      [5, 3], [5, 4], [5, 7], [5, 8],
      [6, 3], [6, 4], [6, 5], [6, 6], [6, 7], [6, 8],
      [7, 4], [7, 5], [7, 6], [7, 7]
    ],
    // gear bays: main legs (interval 2), nose leg (interval 6)
    "huecos": [[2, 0], [2, 1], [2, 10], [2, 11], [6, 0], [6, 11]],
    "tapas": [false, true],
    "interior": [204, 200, 190],
    "pintura": [
      { "caras": [0, 1, 10, 11], "color": [58, 60, 64] },
      { "caras": [2, 9], "color": [64, 66, 72] },
      { "caras": [3, 8], "tramos": [1, 3], "color": [230, 110, 30] },
      { "caras": [5, 6], "tramos": [8, 9], "color": [52, 54, 58] }
    ]
  },
  "suelos": [
    { "id": "suelo_bodega", "desde": [-1.9, -9.3], "hasta": [1.9, -3.4], "divisiones": [3, 5], "material": "panel_suelo", "compartimento": "bodega", "color": [120, 124, 126] },
    { "id": "suelo_cabina", "desde": [-1.9, -3.4], "hasta": [1.9, 2.6], "divisiones": [3, 5], "material": "panel_suelo", "compartimento": "cabina", "color": [132, 134, 136] },
    { "id": "suelo_puente", "desde": [-1.65, 2.6], "hasta": [1.65, 4.6], "divisiones": [2, 2], "material": "panel_suelo", "compartimento": "puente", "color": [100, 104, 108] },
    { "id": "suelo_morro", "desde": [-1.15, 4.6], "hasta": [1.15, 6.85], "divisiones": [2, 2], "material": "panel_suelo", "compartimento": "puente", "color": [100, 104, 108] }
  ],
  "mamparos": [
    { "id": "popa", "z": -9.3, "puerta": [-1.56, 1.56, 2.56], "desde_y": -0.62, "material": "panel_mamparo", "entre": ["bodega", "vacio"], "color": [150, 150, 146] },
    { "id": "mamparo_bodega", "z": -3.4, "puerta": [-0.5, 0.5, 2.0], "material": "panel_mamparo", "entre": ["bodega", "cabina"] },
    { "id": "mamparo_puente", "z": 2.6, "puerta": [-0.45, 0.45, 1.95], "material": "panel_mamparo", "entre": ["cabina", "puente"] },
    { "id": "mamparo_morro", "z": 6.9, "material": "panel_mamparo", "entre": ["puente", "vacio"] }
  ],

  // ------------------------------------------------------------------ components
  "componentes": [
    // ---- flight deck ----
    // the pilots sit close to the console (their eyes a metre from the main panel), the pedestal
    // between them and a side console by each; the overhead console hangs under the canopy ahead
    // of their heads, tilted to face them (crates/ship/tests/asientos.rs holds all this)
    { "id": "asiento_piloto", "tipo": "asiento", "en": [0.62, 0, 4.71] },
    { "id": "asiento_copiloto", "tipo": "asiento", "en": [-0.62, 0, 4.71] },
    { "id": "consola", "tipo": "consola_puente", "en": [0, 0, 5.75] },
    { "id": "pedestal", "tipo": "pedestal", "en": [0, 0, 5.02] },
    { "id": "techo_puente", "tipo": "consola_techo", "en": [0, 2.07, 5.32], "rot": [22, 0, 0] },
    { "id": "lateral_piloto", "forma": { "kind": "box", "size": [0.3, 0.66, 0.7] }, "estilo": "consola_lateral", "en": [1.12, 0.33, 5.0], "material": "aluminio", "color": [62, 64, 70] },
    { "id": "lateral_copiloto", "forma": { "kind": "box", "size": [0.3, 0.66, 0.7] }, "estilo": "consola_lateral", "en": [-1.12, 0.33, 5.0], "material": "aluminio", "color": [62, 64, 70] },
    { "id": "rack_avionica", "tipo": "rack", "en": [-1.45, 0, 3.05],
      "maquina": { "puertos": { "alimentacion": "elec:c_avionica" }, "params": { "siempre": true } } },
    { "id": "ordenador", "tipo": "ordenador", "en": [0, 0.05, 7.6],
      "maquina": { "puertos": { "energia": "elec:c_avionica", "datos": "datos:fc" }, "params": { "siempre": false }, "ordenes": { "encender": "ordenador.encender" } } },
    { "id": "plafon_puente_1", "tipo": "plafon", "en": [0, 2.72, 3.1], "maquina": { "puertos": { "alimentacion": "elec:c_luces_puente" }, "ordenes": { "encender": "luces.puente" } } },
    { "id": "plafon_puente_2", "tipo": "plafon", "en": [0, 2.6, 3.95], "maquina": { "puertos": { "alimentacion": "elec:c_luces_puente" }, "ordenes": { "encender": "luces.puente" } } },
    { "id": "emergencia_puente", "tipo": "luz_emergencia", "en": [0.7, 2.62, 3.0], "maquina": { "puertos": { "alimentacion": "elec:c_emerg" }, "ordenes": { "encender": "luces.emergencia" } } },
    { "id": "foco_izq", "tipo": "foco", "en": [0.45, -0.3, 7.6], "rot": [115, 0, 0], "espejo": true,
      "maquina": { "puertos": { "alimentacion": "elec:c_luces_ext" }, "ordenes": { "encender": "luces.aterrizaje" } } },

    // ---- cabin ----
    { "id": "asiento_c1", "tipo": "asiento", "en": [1.39, 0, -2.3], "rot": [0, -90, 0] },
    { "id": "asiento_c2", "tipo": "asiento", "en": [1.39, 0, -1.5], "rot": [0, -90, 0] },
    { "id": "asiento_c3", "tipo": "asiento", "en": [-1.39, 0, -2.3], "rot": [0, 90, 0] },
    { "id": "asiento_c4", "tipo": "asiento", "en": [-1.39, 0, -1.5], "rot": [0, 90, 0] },
    { "id": "armario_1", "tipo": "armario", "en": [1.62, 0, 1.75] },
    { "id": "armario_2", "tipo": "armario", "en": [-1.62, 0, 1.75], "rot": [0, 180, 0] },
    { "id": "plafon_cab", "tipo": "plafon", "en": [0, 2.88, -2.4], "repetir": [3, [0, 0, 2.0]],
      "maquina": { "puertos": { "alimentacion": "elec:c_luces_cab" }, "ordenes": { "encender": "luces.cabina" } } },
    { "id": "emergencia_cab", "tipo": "luz_emergencia", "en": [0.8, 2.82, -0.9], "maquina": { "puertos": { "alimentacion": "elec:c_emerg" }, "ordenes": { "encender": "luces.emergencia" } } },
    { "id": "tira_izq", "tipo": "tira_suelo", "en": [1.86, 0.01, -1.6], "repetir": [2, [0, 0, 1.6]], "espejo": true,
      "maquina": { "puertos": { "alimentacion": "elec:c_luces_cab" }, "ordenes": { "encender": "luces.suelo" } } },
    { "id": "ventilador_izq", "tipo": "ventilador", "en": [0.95, 2.58, -2.95], "espejo": true,
      "maquina": { "puertos": { "motor": "elec:c_soporte", "aire": "aire:plenum" }, "ordenes": { "marcha": "aire.vent" } } },
    { "id": "depurador", "tipo": "depurador", "en": [0.0, 2.62, -2.95],
      "maquina": { "puertos": { "energia": "elec:c_soporte", "aire": "aire:plenum" }, "ordenes": { "marcha": "aire.depurador" } } },
    { "id": "inyector_o2", "tipo": "inyector", "en": [0.45, 2.25, -3.18],
      "maquina": { "puertos": { "gas": "o2:salida", "aire": "aire:plenum" }, "ordenes": { "marcha": "aire.o2" },
        "params": { "gas": "o2", "sensor": "cabina.o2", "consigna": "21 kPa", "caudal": "0.006 kg/s", "permiso": "cabina.estanco" } } },
    { "id": "inyector_n2", "tipo": "inyector", "en": [-0.45, 2.25, -3.18],
      "maquina": { "puertos": { "gas": "n2:salida", "aire": "aire:plenum" }, "ordenes": { "marcha": "aire.n2" },
        "params": { "gas": "n2", "sensor": "cabina.p", "consigna_senal": "aire.consigna", "consigna": "70 kPa", "caudal": "0.02 kg/s", "permiso": "cabina.estanco" } } },
    // repressurising the hold: straight from the bottles into it, while it is sealed (REPRES.)
    { "id": "repres_o2", "tipo": "inyector", "en": [-1.86, 1.75, -5.3], "rot": [0, 90, 0],
      "maquina": { "puertos": { "gas": "o2:bodega" }, "ordenes": { "marcha": "bodega.repres" },
        "params": { "gas": "o2", "sensor": "bodega.o2", "consigna": "21 kPa", "caudal": "0.5 kg/s", "permiso": "bodega.estanco" } } },
    { "id": "repres_n2", "tipo": "inyector", "en": [-1.86, 1.75, -5.65], "rot": [0, 90, 0],
      "maquina": { "puertos": { "gas": "n2:bodega" }, "ordenes": { "marcha": "bodega.repres" },
        "params": { "gas": "n2", "sensor": "bodega.n2", "consigna": "49 kPa", "caudal": "1.1 kg/s", "permiso": "bodega.estanco" } } },
    { "id": "rejilla_cab_a", "tipo": "rejilla", "en": [-0.55, 2.9, 0.6], "maquina": { "puertos": { "aire": "aire:cab_a" } } },
    { "id": "rejilla_cab_b", "tipo": "rejilla", "en": [-0.55, 2.9, -1.4], "maquina": { "puertos": { "aire": "aire:cab_b" } } },
    { "id": "rejilla_puente", "tipo": "rejilla", "en": [-0.55, 2.6, 3.05], "maquina": { "puertos": { "aire": "aire:puente_a" } } },
    { "id": "rejilla_bod_a", "tipo": "rejilla", "en": [-0.55, 2.86, -7.0], "maquina": { "puertos": { "aire": "aire:bod_a" }, "params": { "compuerta": "bodega.repres" } } },
    { "id": "rejilla_bod_b", "tipo": "rejilla", "en": [-0.55, 2.86, -4.6], "maquina": { "puertos": { "aire": "aire:bod_b" }, "params": { "compuerta": "bodega.repres" } } },
    { "id": "baranda_cab", "tipo": "baranda", "en": [1.82, 1.05, -0.4], "espejo": true },

    // ---- hold ----
    { "id": "reactor", "tipo": "reactor_compacto", "en": [-1.3, 0, -8.35],
      "maquina": { "puertos": { "calor": "calor1:lazo", "flujo": "refrig1:rx", "control": "elec:c_reactor" },
        "ordenes": { "marcha": "rx.marcha", "potencia": "rx.potencia", "scram": "rx.scram", "rearme": "rx.rearme" } } },
    { "id": "conversor", "tipo": "conversor_termico", "en": [-1.5, 0, -7.05],
      "maquina": { "puertos": { "caliente": "calor1:lazo", "frio": "calor2:lazo", "salida": "alta:salida", "flujo": "refrig1:conv" } } },
    { "id": "bucle_1", "tipo": "deposito_refrigerante", "en": [-1.65, 0, -6.35], "maquina": { "puertos": { "calor": "calor1:lazo" }, "params": { "t_inicial": "30 °C", "masa": "1.5 kg" } } },
    { "id": "bomba_1", "tipo": "bomba_refrigerante", "en": [-1.15, 0, -6.35],
      "maquina": { "puertos": { "motor": "elec:c_refrig", "salida": "refrig1:b1" }, "ordenes": { "marcha": "refrig.b1" } } },
    { "id": "bucle_2", "tipo": "deposito_refrigerante", "en": [-1.65, 0, -5.65], "maquina": { "puertos": { "calor": "calor2:lazo" }, "params": { "t_inicial": "10 °C" } } },
    { "id": "bomba_2", "tipo": "bomba_refrigerante", "en": [-1.15, 0, -5.65],
      "maquina": { "puertos": { "motor": "elec:c_refrig", "salida": "refrig2:b2" }, "ordenes": { "marcha": "refrig.b2" } } },
    { "id": "bateria_1", "tipo": "bateria", "en": [1.5, 0, -8.6], "maquina": { "puertos": { "bornes": "elec:bat1" }, "params": { "siempre": true } } },
    // battery 2 and converter B are across the ship from 1 and A: no one hit takes both
    { "id": "bateria_2", "tipo": "bateria", "en": [-1.55, 0, 0.35], "rot": [0, 90, 0], "maquina": { "puertos": { "bornes": "elec:bat2" }, "params": { "siempre": true, "soc_inicial": 0.8 } } },
    { "id": "hpu_a", "tipo": "unidad_hidraulica", "en": [1.5, 0, -7.2],
      "maquina": { "puertos": { "motor": "elec:c_hid_a", "presion": "hid:hpu_a" }, "ordenes": { "marcha": "hid.a" } } },
    { "id": "hpu_b", "tipo": "unidad_hidraulica", "en": [1.5, 0, -6.5],
      "maquina": { "puertos": { "motor": "elec:c_hid_b", "presion": "hid:hpu_b" }, "ordenes": { "marcha": "hid.b" } } },
    { "id": "acumulador", "tipo": "acumulador", "en": [1.8, 0, -5.9], "maquina": { "puertos": { "presion": "hid:acum" } } },
    { "id": "conv_a", "tipo": "convertidor_cc", "en": [1.7, 0, -5.35], "maquina": { "puertos": { "entrada": "alta:dc_a", "salida": "elec:conv_a" } } },
    { "id": "conv_b", "tipo": "convertidor_cc", "en": [-1.7, 0, -3.85], "maquina": { "puertos": { "entrada": "alta:dc_b", "salida": "elec:conv_b" } } },
    { "id": "botella_o2_1", "tipo": "botella", "etiqueta": "O2", "en": [-1.75, 0, -4.9], "color": [235, 235, 232], "maquina": { "puertos": { "salida": "o2:botellas" } } },
    { "id": "botella_o2_2", "tipo": "botella", "etiqueta": "O2", "en": [-1.75, 0, -4.55], "color": [235, 235, 232], "maquina": { "puertos": { "salida": "o2:botellas" } } },
    // (a bottle takes what fits in it at 20 MPa: 13 kg of oxygen, 10 of nitrogen. Filling the
    // hold once takes 33 kg of nitrogen: four bottles of it, three of them a second row inboard)
    { "id": "botella_n2", "tipo": "botella", "etiqueta": "N2", "en": [-1.75, 0, -4.2], "color": [40, 40, 44], "contenido": { "sustancia": "nitrogeno" }, "maquina": { "puertos": { "salida": "n2:botella" } } },
    { "id": "botella_n2_2", "tipo": "botella", "etiqueta": "N2", "en": [-1.47, 0, -4.2], "color": [40, 40, 44], "contenido": { "sustancia": "nitrogeno" }, "maquina": { "puertos": { "salida": "n2:botella" } } },
    { "id": "botella_n2_3", "tipo": "botella", "etiqueta": "N2", "en": [-1.47, 0, -4.55], "color": [40, 40, 44], "contenido": { "sustancia": "nitrogeno" }, "maquina": { "puertos": { "salida": "n2:botella" } } },
    { "id": "botella_n2_4", "tipo": "botella", "etiqueta": "N2", "en": [-1.47, 0, -4.9], "color": [40, 40, 44], "contenido": { "sustancia": "nitrogeno" }, "maquina": { "puertos": { "salida": "n2:botella" } } },
    // (its starter on its own circuit, behind the APU breaker: pulled, it does not start)
    { "id": "apu", "tipo": "apu", "en": [0, 2.12, -8.55],
      "maquina": { "puertos": { "salida": "elec:gen_apu", "combustible": "prop:apu", "arranque": "elec:c_apu" }, "ordenes": { "marcha": "apu.marcha" } } },
    { "id": "plafon_bod", "tipo": "plafon", "en": [0, 2.84, -6.6], "repetir": [2, [0, 0, 2.0]],
      "maquina": { "puertos": { "alimentacion": "elec:c_luces_bod" }, "ordenes": { "encender": "luces.bodega" } } },
    { "id": "emergencia_bod", "tipo": "luz_emergencia", "en": [0.9, 2.82, -5.6], "maquina": { "puertos": { "alimentacion": "elec:c_emerg" }, "ordenes": { "encender": "luces.emergencia" } } },
    // air moved on purpose (docs/AIRE.md): the compressor that draws a compartment down into the
    // tank of recovered air (or into another compartment), and that tank. Its panel is on the
    // wall over it and the hand valves are in the bulkheads: "trasvase", further down
    { "id": "compresor_aire", "tipo": "compresor_aire", "en": [1.5, 0, -7.9],
      "maquina": { "puertos": { "motor": "elec:c_compresor" }, "params": { "lugares": ["deposito_aire", "bodega", "cabina", "puente"] } } },
    { "id": "deposito_aire", "tipo": "deposito_aire", "en": [1.55, 0, -4.4] },
    { "id": "foco_bodega_izq", "tipo": "foco", "en": [1.0, 2.5, -7.7], "rot": [-140, 0, 0], "espejo": true,
      "luz": { "color": [255, 240, 220], "alcance": 16.0, "intensidad": 7.0, "en": [0, 0.09, 0], "lente": 0.1, "dir": [0, 1, 0], "cono": 80.0 },
      "maquina": { "puertos": { "alimentacion": "elec:c_luces_bod" }, "ordenes": { "encender": "luces.focos_bodega" } } },

    // cargo, lashed down the middle of the hold (a walkway each side, the cabin door clear)
    // cargo is not of the ship: each piece is held by its clamp ("anclaje") and by nothing else.
    // Open the clamp (a hand on it, its order `<id>.soltar`), or lose it, and what it held is a
    // loose body (crates/ship/src/cargo.rs, tests/carga.rs)
    // The cargo stands a little to port of the middle, against the machinery there, so that the
    // starboard side is a walkway 0.68 m wide from the cabin door to the ramp (tests/carga.rs)
    { "id": "anclaje_pale", "tipo": "anclaje_carga", "en": [-0.13, 0, -8.0] },
    { "id": "anclaje_cajas", "tipo": "anclaje_carga", "en": [-0.13, 0, -6.665] },
    { "id": "anclaje_agua", "tipo": "anclaje_carga", "en": [-0.13, 0, -5.75] },
    { "id": "anclaje_prop", "tipo": "anclaje_carga", "en": [-0.13, 0, -5.2] },
    { "id": "carga_pale", "tipo": "pale_regolito", "en": [-0.13, 0.012, -8.0], "anclaje": "anclaje_pale" },
    { "id": "carga_caja_1", "tipo": "caja_repuestos", "en": [0.132, 0.012, -6.95], "anclaje": "anclaje_cajas" },
    { "id": "carga_caja_2", "tipo": "caja_repuestos", "en": [-0.392, 0.012, -6.95], "anclaje": "anclaje_cajas" },
    { "id": "carga_caja_3", "tipo": "caja_repuestos", "en": [0.132, 0.012, -6.38], "anclaje": "anclaje_cajas" },
    { "id": "carga_caja_4", "tipo": "caja_repuestos", "en": [-0.23, 0.525, -6.9], "rot": [0, 14, 0], "anclaje": "anclaje_cajas" },
    { "id": "carga_agua_1", "tipo": "bidon_agua", "en": [-0.47, 0.012, -5.75], "anclaje": "anclaje_agua" },
