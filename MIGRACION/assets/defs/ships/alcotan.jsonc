    // 120 V from the reactor's thermoelectric converter to the two DC-DC converters
    "alta": {
      "medio": "electrico", "nominal": "120 V", "conducto": "cable_grueso", "color": [150, 40, 40],
      "nodos": { "salida": [-1.5, 0.95, -7.05], "dc_a": [1.7, 0.75, -5.35], "dc_b": [-1.7, 0.75, -3.85] },
      // each converter on its own run from the reactor's
      "tramos": [
        { "de": "salida", "a": "dc_a" },
        { "de": "salida", "a": "dc_b" }
      ]
    },
    "datos": {
      "medio": "datos", "conducto": "datos",
      "nodos": { "fc": [0, 0.4, 7.6], "puente": [0.6, 0.3, 5.3], "lateral": [1.12, 0.6, 4.4] },
      "tramos": [ { "de": "fc", "a": "puente" }, { "de": "puente", "a": "lateral" } ]
    },
    // hydraulics: two pumps and an accumulator on one manifold under the deck
    "hid": {
      "medio": "hidraulico", "nominal": "21 MPa", "conducto": "tubo_alta", "fuga": "0.0004 m3/s",
      "nodos": { "hpu_a": [1.5, 0.75, -7.2], "hpu_b": [1.5, 0.75, -6.5], "acum": [1.8, 0.62, -5.9], "colector": [1.2, -0.3, -5.9], "morro_v": [1.0, -0.3, -5.9],
                 "tren_izq": [1.3, -0.35, -4.2], "tren_der": [-1.3, -0.35, -4.2], "tren_morro": [0, -0.3, 4.4] },
