  // ------------------------------------------------------------------ networks
  // (its wiring and its pipes are inside its armour: nothing of them is seen, nor cut alone)
  "redes": {
    // 28 V on two buses: battery 1 and bus A to port, battery 2 and bus B to starboard, the
    // power pack to both, a tie between them, and an essential bar fed from either
    "elec": {
      "medio": "electrico", "nominal": "28 V", "conducto": "cable",
      "nodos": { "bat1": [0.8, 0.6, -2.42], "bat2": [-0.8, 0.6, -3.0], "rx": [-0.52, 1.5, -1.85], "bus_a": [0.9, 1.4, -2.0], "bus_b": [-0.9, 1.4, -2.6], "ess": [0, 1.4, -1.3],
                 "c_motores": [0, 1.5, -1.3], "c_armas": [-0.9, 1.5, -2.6], "c_sensores": [0.9, 1.5, -2.0], "c_hid": [0.9, 1.3, -3.0],
                 "c_avionica": [0.3, 1.5, -1.3], "c_luces": [-0.3, 1.5, -1.3], "c_mec": [0, 1.6, -1.3], "c_reactor": [-0.52, 1.6, -1.6] },
      "interruptores": [
        { "id": "ct.bat1", "de": "bat1", "a": "bus_a" },
        { "id": "ct.bat2", "de": "bat2", "a": "bus_b" },
        { "id": "ct.rx_a", "de": "rx", "a": "bus_a", "senal": "ct.rx" },
        { "id": "ct.rx_b", "de": "rx", "a": "bus_b", "senal": "ct.rx" },
        { "id": "ct.enlace", "de": "bus_a", "a": "bus_b" },
        { "id": "ct.ess_a", "de": "bus_a", "a": "ess", "senal": "ct.ess" },
        { "id": "ct.ess_b", "de": "bus_b", "a": "ess", "senal": "ct.ess" },
        // the circuits a pilot may want to cut, each behind its breaker (on the throttle console)
        { "id": "brk.motores", "de": "ess", "a": "c_motores", "medir": true },
        { "id": "brk.armas", "de": "bus_b", "a": "c_armas", "medir": true },
        { "id": "brk.sensores", "de": "bus_a", "a": "c_sensores", "medir": true },
        { "id": "brk.hid", "de": "bus_a", "a": "c_hid", "medir": true },
        { "id": "brk.avionica", "de": "ess", "a": "c_avionica", "medir": true },
        { "id": "brk.luces", "de": "ess", "a": "c_luces", "medir": true },
        { "id": "brk.mec", "de": "ess", "a": "c_mec", "medir": true },
        { "id": "brk.reactor", "de": "ess", "a": "c_reactor", "medir": true }
      ]
    },
    "datos": { "medio": "datos", "conducto": "datos", "nodos": { "fc": [0.78, 1.05, -1.52] } },
    "prop": {
      "medio": "propelente", "nominal": "2.4 MPa", "conducto": "tubo", "fuga": "2 kg/s",
      "nodos": { "tanques": [1.3, 0.7, -0.9], "colector": [0, -0.1, -0.9] },
      "interruptores": [ { "id": "pv.prop", "de": "tanques", "a": "colector" } ]
    },
    "hid": {
      "medio": "hidraulico", "nominal": "21 MPa", "conducto": "tubo_alta", "fuga": "0.0004 m3/s",
      "nodos": { "colector": [0.72, -0.1, -3.3] }
    }
  },

  // ------------------------------------------------------------------ panels, seats
  "paneles": [
    { "id": "principal", "panel": "azor_principal", "pieza": "consola.cara", "en": [0, 0.935, 1.85], "normal": [0, 0.6, -0.8], "energia": "elec:c_avionica", "cableado": false },
    { "id": "mando", "panel": "azor_mando", "pieza": "lateral_der", "en": [-0.62, 0.662, 1.14], "normal": [0, 1, 0], "arriba": [0, 0, 1], "energia": "elec:c_avionica", "cableado": false },
    { "id": "gases", "panel": "azor_gases", "pieza": "lateral_izq", "en": [0.62, 0.662, 1.14], "normal": [0, 1, 0], "arriba": [0, 0, 1], "energia": "elec:c_avionica", "cableado": false },
    // the drum's three faces, where each is with the drum at rest (NAVEGACIÓN to the pilot)
    { "id": "nav", "panel": "azor_nav", "pieza": "tambor", "en": [0.6545, 1.035, 1.25], "normal": [-0.766, 0.643, 0], "arriba": [0.643, 0.766, 0], "energia": "elec:c_avionica", "cableado": false },
    { "id": "combate", "panel": "azor_combate", "pieza": "tambor", "en": [0.8004, 1.0092, 1.25], "normal": [0.94, 0.342, 0], "arriba": [0.342, -0.94, 0], "energia": "elec:c_avionica", "cableado": false },
    { "id": "sensores", "panel": "azor_sensores", "pieza": "tambor", "en": [0.7051, 0.8958, 1.25], "normal": [-0.174, -0.985, 0], "arriba": [-0.985, 0.174, 0], "energia": "elec:c_avionica", "cableado": false },
    { "id": "sistemas", "panel": "azor_sistemas", "pieza": "repisa.cara", "en": [-0.775, 1.035, 1.25], "normal": [0.766, 0.643, 0], "arriba": [-0.643, 0.766, 0], "energia": "elec:c_avionica", "cableado": false },
    // on the seat's right armrest, going down and up with it: the one control one needs sat on it
    // with the platform at the ground
    { "id": "brazo", "panel": "azor_asiento", "pieza": "asiento.brazo_d", "en": [-0.31, 0.652, 0.97], "normal": [0, 1, 0], "arriba": [0, 0, 1], "energia": "elec:c_avionica", "cableado": false },
    { "id": "bahia", "panel": "azor_bahia", "en": [0.42, 1.3, -1.235], "normal": [0, 0, -1], "energia": "elec:c_avionica", "cableado": false },
    { "id": "exterior", "panel": "azor_exterior", "pieza": "caja_acceso", "en": [1.351, -0.95, -2.6], "normal": [1, 0, 0], "energia": "elec:c_avionica", "cableado": false }
  ],
  // where one gets off the seat with its platform down: the ground on either side of the ship
  // (with it up, the seat's own exit: the cockpit's floor behind it)
  "bajadas": [
    { "id": "suelo_izq", "en": [2.3, -2.4, 1.6], "zona": [0.6, 1.6], "rumbo": 90, "baja": 1.0 },
    { "id": "suelo_der", "en": [-2.3, -2.4, 1.6], "zona": [0.6, 1.6], "rumbo": -90, "baja": 1.0 }
  ],
  "asientos": [
    { "id": "piloto", "nombre": "Asiento del Azor", "pieza": "asiento.cojin", "ojos": [0, 1.35, 0.96], "rumbo": 0, "salida": [0.0, 0.0, -0.5],
      "paneles": ["principal", "mando", "gases", "nav", "sistemas", "brazo"],
      "mandos": [
        { "tecla": "W", "mando": "mando/palanca", "eje": 0, "valor": 1.0, "ayuda": "Palanca de mando: cabeceo (morro abajo y arriba)" },
        { "tecla": "S", "mando": "mando/palanca", "eje": 0, "valor": -1.0, "ayuda": "Palanca de mando: cabeceo (morro abajo y arriba)" },
        { "tecla": "E", "mando": "mando/palanca", "eje": 1, "valor": 1.0, "ayuda": "Palanca de mando: alabeo (inclinarse a un lado y a otro)" },
        { "tecla": "Q", "mando": "mando/palanca", "eje": 1, "valor": -1.0, "ayuda": "Palanca de mando: alabeo (inclinarse a un lado y a otro)" },
        { "tecla": "A", "mando": "mando/guinada", "eje": 0, "valor": 1.0, "ayuda": "Guiñada (girar el morro a izquierda y derecha)" },
        { "tecla": "D", "mando": "mando/guinada", "eje": 0, "valor": -1.0, "ayuda": "Guiñada (girar el morro a izquierda y derecha)" },
        { "tecla": "R", "mando": "mando/vertical", "eje": 0, "valor": 1.0, "ayuda": "Subir y bajar con los propulsores de maniobra" },
        { "tecla": "F", "mando": "mando/vertical", "eje": 0, "valor": -1.0, "ayuda": "Subir y bajar con los propulsores de maniobra" },
        { "tecla": "I", "mando": "mando/traslacion", "eje": 0, "valor": 1.0, "ayuda": "Traslación adelante y atrás (propulsores de maniobra)" },
        { "tecla": "K", "mando": "mando/traslacion", "eje": 0, "valor": -1.0, "ayuda": "Traslación adelante y atrás (propulsores de maniobra)" },
        { "tecla": "J", "mando": "mando/traslacion", "eje": 1, "valor": 1.0, "ayuda": "Traslación a los lados (propulsores de maniobra)" },
        { "tecla": "L", "mando": "mando/traslacion", "eje": 1, "valor": -1.0, "ayuda": "Traslación a los lados (propulsores de maniobra)" },
        { "tecla": "Mayús", "mando": "gases/acelerador", "accion": "subir", "ayuda": "Acelerador de los motores: más" },
        { "tecla": "Ctrl", "mando": "gases/acelerador", "accion": "bajar", "ayuda": "Acelerador de los motores: menos" },
        { "tecla": "X", "mando": "gases/acelerador", "accion": "cero", "ayuda": "Acelerador de los motores: a cero" },
        { "tecla": "H", "mando": "mando/gatillo", "accion": "pulsar", "ayuda": "Gatillo: dispara el arma elegida (maestro de armas en ARMADO)" },
        { "tecla": "M", "mando": "combate/cm_soltar", "accion": "pulsar", "ayuda": "Soltar señuelos (dipolos y bengala)" },
        { "tecla": "N", "mando": "principal/obj_sig", "accion": "pulsar", "ayuda": "Elegir la traza siguiente" },
        { "tecla": "U", "mando": "principal/obj_cerca", "accion": "pulsar", "ayuda": "Elegir la traza más cercana" },
        { "tecla": "B", "mando": "principal/obj_fijar", "accion": "pulsar", "ayuda": "Fijar el radar en la traza elegida (o soltarla)" },
        { "tecla": "P", "mando": "brazo/plataforma", "accion": "pulsar", "ayuda": "Subir o bajar el asiento (la plataforma, por las compuertas de la panza; solo posada)" }
      ] }
  ],

  // ------------------------------------------------------------------ logic
  // (what has no switch of its own stays shut: the power pack's contactors, the essential bar's)
  "senales": { "ct.rx": 1, "ct.ess": 1 },
  "derivadas": {
    // one order for the two doors of the bay, from the cockpit, the bay or outside
    "rampa.orden": "toggle(sistemas.compuertas || bahia.compuertas || exterior.compuertas)",
    // the seat's platform: asked for from any of its buttons; the belly doors open first, the
    // platform moves only with both open, and they shut once it is up again
    "plataforma.pide": "toggle(sistemas.plataforma || exterior.plataforma || brazo.plataforma)",
    "panza.orden": "plataforma.pide || plataforma.pos > 0.005",
    "plataforma.orden": "plataforma.pide && panza_izq.abierta > 0.97 && panza_der.abierta > 0.97",
    "tambor.orden": "tambor.cara / 2",
    // the nacelles: the flight computer's while it holds or the autopilot flies (it swings them
    // to where the push is wanted, back too: that is how it brakes with its hull level); else
    // the pilot's lever, from pushing back (0) through straight up (0.5) to straight ahead (1)
    "gondolas.mando": "if(vuelo.vector_on, vuelo.vector, gondolas.orden)",
    "rad.fuera": "(rad_izq.pos + rad_der.pos) / 2",
    "luces.bahia": "luces.bahia_cabina || luces.bahia_local",
    "tren.verde_i": "act_pata_izq.bloqueado && pata_izq.pos > 0.95",
    "tren.verde_d": "act_pata_der.bloqueado && pata_der.pos > 0.95",
    "tren.verde_m": "act_pata_morro.bloqueado && pata_morro.pos > 0.95",
    "alarma.tren": "for(tren.orden && !(tren.verde_i && tren.verde_d && tren.verde_m), 20 s) || (!tren.orden && nave.altura < 15 m && nave.vs < -1 m/s)",
    "alarma.disyuntor": "!(brk.motores && brk.armas && brk.sensores && brk.hid && brk.avionica && brk.luces && brk.mec && brk.reactor)",
    "alarma.algo": "elec.bus_a < 22 V || elec.bus_b < 22 V || (hid.marcha && hid.colector < 12 MPa) || alarma.tren || alarma.disyuntor || reactor.estado == 3 || gondola_izq.estado == 6 || gondola_der.estado == 6 || rwr.fijado || rwr.misil",
    "alarma.general": "latch(edge(alarma.algo), panel.reconocer)",
    "sonido.alarma": "alarma.general && elec.c_avionica > 18 V"
  },
  "enclavamientos": [
    { "mando": "principal/tren", "hacia": 0, "si": "nave.altura < 2 m", "motivo": "Peso sobre el tren" },
    { "mando": "sistemas/plataforma", "si": "nave.altura > 4 m", "motivo": "En vuelo: la plataforma solo se mueve posado" },
    { "mando": "exterior/plataforma", "si": "nave.altura > 4 m", "motivo": "En vuelo: la plataforma solo se mueve posado" },
    { "mando": "brazo/plataforma", "si": "nave.altura > 4 m", "motivo": "En vuelo: la plataforma solo se mueve posado" }
  ],
  "alarmas": {
    "Bus A sin tensión": "elec.bus_a < 20 V",
    "Bus B sin tensión": "elec.bus_b < 20 V",
    "Presión hidráulica baja": "hid.marcha && hid.colector < 10 MPa",
    "Un disyuntor abierto": "alarma.disyuntor",
    "Grupo de energía parado por un disparo": "reactor.estado == 3",
    "Grupo de energía limitado por temperatura: da menos de lo pedido (saca los radiadores)": "reactor.limitado",
    "Motor izquierdo: fallo": "gondola_izq.estado == 6",
    "Motor derecho: fallo": "gondola_der.estado == 6",
    "Tren sin blocar": "alarma.tren",
    "Un radar tiene fijada la nave": "rwr.fijado",
    "Misil hacia la nave": "rwr.misil",
    "Giróscopos saturados": "giroscopo.carga > 0.95"
  },

  // No gravity of its own (a fighter flown in the suit, strapped in): on it one weighs what is left of the
  // world's pull as it goes (all of it parked, nothing in free fall)
  "gravedad": { "g": 0.0, "tiempo": 0.0 },
  "vuelo": {
    "cabeceo": "vuelo.cabeceo", "alabeo": "vuelo.alabeo", "guinada": "vuelo.guinada",
    "traslacion": ["vuelo.tx", "vuelo.ty", "vuelo.tz"], "acelerador": "vuelo.acelerador",
    "estabilizador": "vuelo.sas", "mantener": "vuelo.mantener",
    "giro": [45, 45, 70], "ganancia": 3.0,
    "rcs": ["rcs_*"], "motores": ["gondola_izq", "gondola_der"], "ordenador": "ordenador",
    "ruedas": ["giroscopo"],
    "perfil": "fcs.perfil", "limite": "fcs.limite"
  }
}
