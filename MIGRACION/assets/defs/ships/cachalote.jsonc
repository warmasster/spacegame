  "bajadas": [
    {"id": "puente", "en": [0, 0, 7.5], "zona": [1.8, 1.2]},
    {"id": "cabina", "en": [0, 0, 2.1], "zona": [0.6, 2.4]}
  ],
  "senales": {"aire.consigna": "70 kPa"},
  "derivadas": {
    "rampa.orden": "!toggle(rampa_bodega.rampa || rampa_ext.rampa)",
    "puerta_bodega.orden": "toggle(puerta_bodega_h.boton || puerta_bodega_c.boton)",
    "puerta_puente.orden": "toggle(puerta_puente_c.boton || puerta_puente_p.boton)",
    "puerta_bodega.dp": "abs(cabina.p - bodega.p)",
    "bodega.venteo": "bodega.venteo_soporte || rampa_bodega.venteo || rampa_ext.venteo",
    "bodega.repres": "bodega.repres_soporte",
    "puerta_puente.dp": "abs(puente.p - cabina.p)",
    "luces.emergencia": "elec.bus_a < 22 V && elec.bus_ess > 18 V",
    "luces.focos_bodega": "rampa_bodega.focos",
    "tren.verde_i": "act_tren_izq.bloqueado && tren_izq.pos > 0.95",
    "tren.verde_d": "act_tren_der.bloqueado && tren_der.pos < 0.05",
    "tren.verde_m": "act_tren_morro.bloqueado && tren_morro.pos < 0.05",
    "alarma.tren": "for(tren.orden && !(tren.verde_i && tren.verde_d && tren.verde_m), 20 s) || (!tren.orden && nave.altura < 15 m && nave.vs < -1 m/s)",
    "alarma.disyuntor": "!(brk.grua && brk.giro && brk.luces_cab && brk.luces_bod && brk.puertas && brk.rampa && brk.hid_a && brk.soporte && brk.refrig && brk.compresor && brk.luces_puente && brk.luces_ext && brk.hid_b && brk.gondolas && brk.tren && brk.motores && brk.rcs && brk.reactor && brk.radiadores && brk.antena && brk.apu && brk.emergencia && brk.avionica && brk.pantallas)",
    "alarma.algo": "elec.bus_a < 22 V || elec.bus_b < 22 V || ((hid.a || hid.b) && hid.colector < 12 MPa) || alarma.tren || alarma.disyuntor || reactor.estado == 3 || cabina.p < 60 kPa || gondola_izq.estado == 6 || gondola_der.estado == 6 || gondola_popa_izq.estado == 6 || gondola_popa_der.estado == 6 || deposito_izq.fuga > 0.05 || deposito_der.fuga > 0.05 || deposito_int_izq.fuga > 0.05 || deposito_int_der.fuga > 0.05 || deposito_popa_izq.fuga > 0.05 || deposito_popa_der.fuga > 0.05 || deposito_popa_int_izq.fuga > 0.05 || deposito_popa_int_der.fuga > 0.05",
    "alarma.general": "latch(edge(alarma.algo), panel.reconocer)",
    "sonido.alarma": "alarma.general && elec.bus_ess > 18 V",
    "abordo.gravedad": "elec.bus_ess > 18 V",
    "cuna.soltar": "cuna.abrir",
    "grua_iman.soltar": "!grua_iman.activo",
    "grua.largo": "1.4 + grua_puente.pos * 15.5",
    "grua.banda": "(grua_carro.pos - 0.5) * 6.0",
    "grua.columna": "clamp(round((1.35 - grua.banda) / 1.35), 0, 2)",
    "grua.fila": "clamp(round((grua.largo - 2.6) / 1.6) + 1, 1, 8)",
    "grua.centrada": "abs(grua.banda - (1.35 - grua.columna * 1.35)) < 0.12 && abs(grua.largo - (2.6 + (grua.fila - 1) * 1.6)) < 0.12",
    "grua.moviendo": "abs(grua.puente - grua_puente.pos) > 0.012 || abs(grua.carro - grua_carro.pos) > 0.012 || abs(grua.gancho - grua_gancho.pos) > 0.012"
  },
  "prioridades": {"en": [4.05, 1.55, -6.7], "normal": [-1, 0, 0], "energia": "elec:c_soporte"},
  "trasvase": {
    "valvulas": [{"id": "vi_bodega", "entre": ["bodega", "cabina"], "en": [-1.5, 0.93, 0.6], "normal": [0, 0, 1], "paso": "150 mm"}, {"id": "vi_puente", "entre": ["cabina", "puente"], "en": [1.5, 0.93, 6.6], "normal": [0, 0, 1], "paso": "150 mm"}, {"id": "vv_bodega", "entre": ["bodega", "vacio"], "en": [3.55, 1.5, -22.0], "normal": [0, 0, -1], "paso": "170 mm"}],
    "compresores": [{"id": "compresor_aire", "panel": {"en": [4.05, 1.55, -8.5], "normal": [-1, 0, 0], "energia": "elec:c_soporte"}}]
  },
  "enclavamientos": [
    {"mando": "principal/tren", "hacia": 0, "si": "nave.altura < 2 m", "motivo": "Peso sobre el tren"},
    {"mando": "rampa_bodega/rampa", "si": "bodega.p > 3 kPa && rampa.cerrada > 0.5", "motivo": "Bodega presurizada: ventéala antes (panel de soporte vital)"},
    {"mando": "rampa_ext/rampa", "si": "bodega.p > 3 kPa && rampa.cerrada > 0.5", "motivo": "Bodega presurizada"},
    {"mando": "puerta_bodega_h/abrir", "si": "puerta_bodega.dp > 5 kPa && puerta_bodega.cerrada > 0.5", "motivo": "Diferencia de presión con la cabina"},
    {"mando": "puerta_bodega_c/abrir", "si": "puerta_bodega.dp > 5 kPa && puerta_bodega.cerrada > 0.5", "motivo": "Diferencia de presión con la bodega"},
    {"mando": "puerta_puente_c/abrir", "si": "puerta_puente.dp > 5 kPa && puerta_puente.cerrada > 0.5", "motivo": "Diferencia de presión con el puente"},
    {"mando": "puerta_puente_p/abrir", "si": "puerta_puente.dp > 5 kPa && puerta_puente.cerrada > 0.5", "motivo": "Diferencia de presión con la cabina"}
  ],
  "esenciales": {
    "Un bus principal con tensi\u00f3n": "elec.bus_a > 20 V || elec.bus_b > 20 V",
    "Bus esencial": "elec.bus_ess > 20 V",
    "Avi\u00f3nica": "elec.c_avionica > 20 V",
    "Pantallas e indicadores": "elec.c_pantallas > 20 V",
    "Luces de emergencia": "elec.c_emerg > 20 V",
    "Soporte vital": "elec.c_soporte > 20 V",
    "Bombas de refrigerante del reactor": "elec.c_refrig > 20 V",
    "Control del reactor": "elec.c_reactor > 20 V",
    "Puertas": "elec.c_puertas > 20 V",
    "Una bomba hidr\u00e1ulica": "elec.c_hid_a > 20 V || elec.c_hid_b > 20 V",
    "Una bater\u00eda en la barra": "bateria_1.soc > 0.05 && elec.bat1 > 20 V || bateria_2.soc > 0.05 && elec.bat2 > 20 V"
  },
  "alarmas": {
    "Bus A sin tensi\u00f3n": "elec.bus_a < 20 V",
    "Bus B sin tensi\u00f3n": "elec.bus_b < 20 V",
    "Presi\u00f3n hidr\u00e1ulica baja": "(hid.a || hid.b) && hid.colector < 10 MPa",
    "SCRAM del reactor": "reactor.estado == 3",
    "Reactor limitado por temperatura: da menos de lo pedido (despliega los radiadores o baja la potencia)": "reactor.limitado",
    "Descompresi\u00f3n en la cabina": "cabina.fuga > 2 kPa",
    "Descompresi\u00f3n en el puente": "puente.fuga > 2 kPa",
    "Fuga de propelente": "deposito_izq.fuga > 0.05 || deposito_der.fuga > 0.05 || deposito_int_izq.fuga > 0.05 || deposito_int_der.fuga > 0.05 || deposito_popa_izq.fuga > 0.05 || deposito_popa_der.fuga > 0.05 || deposito_popa_int_izq.fuga > 0.05 || deposito_popa_int_der.fuga > 0.05",
    "Motor izquierdo: fallo": "gondola_izq.estado == 6",
    "Motor derecho: fallo": "gondola_der.estado == 6",
    "Tren sin blocar": "alarma.tren",
    "Gir\u00f3scopos saturados": "giroscopo.carga > 0.95",
    "Motor de popa izquierdo: fallo": "gondola_popa_izq.estado == 6",
    "Motor de popa derecho: fallo": "gondola_popa_der.estado == 6"
  },
  "vuelo": {
    "cabeceo": "vuelo.cabeceo",
    "alabeo": "vuelo.alabeo",
    "guinada": "vuelo.guinada",
    "traslacion": ["vuelo.tx", "vuelo.ty", "vuelo.tz"],
    "acelerador": "vuelo.acelerador",
    "estabilizador": "vuelo.sas",
    "mantener": "vuelo.mantener",
    "giro": [9, 10, 12],
    "ganancia": 2.5,
    "rcs": ["rcs_*"],
    "motores": ["gondola_izq", "gondola_der", "gondola_popa_izq", "gondola_popa_der"],
    "ordenador": "ordenador",
    "ruedas": ["giroscopo"],
    "descarga": "vuelo.descarga"
  },
  "gravedad": {"g": 1.62, "senal": "abordo.gravedad", "tiempo": 2.0},
  "lleva": [
